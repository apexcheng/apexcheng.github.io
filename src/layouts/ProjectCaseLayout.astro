---
import SiteLayout from './SiteLayout.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import { getProject, projectPath, type Project } from '../data/projects';
import { withBase } from '../utils/paths';
import '../styles/projects.css';

interface Props { project: Project }
const { project } = Astro.props;
const parent = project.parentId ? getProject(project.parentId) : undefined;
const indexHref = withBase('/projects/') + '?case=' + encodeURIComponent(project.id);
const linked = project.links.map((link) => ({
  ...link,
  url: /^https?:\/\//.test(link.href) ? link.href : withBase(link.href),
  external: /^https?:\/\//.test(link.href),
}));
---

<SiteLayout title={project.title} active="projects" description={project.description}>
  <main class="page-content case-detail" data-project-id={project.id}>
    <nav class="case-breadcrumb" aria-label="当前位置">
      <a href={indexHref}>项目索引</a>
      {parent && <><span aria-hidden="true">/</span><a href={withBase(projectPath(parent))}>{parent.title}</a></>}
      <span aria-hidden="true">/</span><span aria-current="page">{project.title}</span>
    </nav>

    <header class="case-detail-hero">
      <div class="case-detail-hero-copy">
        <span class="case-kicker">{project.type}</span>
        <h1>{project.title}</h1>
        <p class="case-detail-lead">{project.lead}</p>
        <div class="case-identity">
          <span>{project.category}</span>
          {project.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </div>
      <aside class="case-hero-margin" aria-labelledby="case-outcomes-title">
        <h2 id="case-outcomes-title">已有成果与现状</h2>
        <ul>{project.outcomes.map((item) => <li>{item}</li>)}</ul>
      </aside>
    </header>

    <div class="case-reading-layout">
      <aside class="case-reading-sidebar">
        <nav aria-label="案例目录">
          <strong>案例目录</strong>
          <a href="#case-background">项目背景</a>
          <a href="#case-process">执行流程</a>
          <a href="#case-decisions">工程取舍</a>
          <a href="#case-summary">项目边界</a>
          {linked.length > 0 && <a href="#case-resources">相关资料</a>}
        </nav>
        <a class="case-index-return" href={indexHref}>← 返回项目索引</a>
      </aside>
      <div class="case-reading-body">
        <div class="case-overview" id="case-background" aria-label="问题背景与解决思路">
          <section>
            <h2>为什么需要这个项目</h2>
            <p>{project.challenge}</p>
          </section>
          <section>
            <h2>解决思路</h2>
            <p>{project.approach}</p>
          </section>
        </div>

        <section class="case-process" id="case-process" aria-labelledby="case-process-title">
          <div class="case-section-title">
            <div><h2 id="case-process-title">{project.id === 'hangqiao' ? '系统职责，先于组件细节。' : project.id === 'inventory-rpa' ? '从卖空预警，到平台库存回写。' : project.id === 'yingdao-agent-development' ? '从查到依据，到验证业务。' : '关键流程，如何衔接。'}</h2></div>
            <p>所有图解均由已确认的项目功能整理，不是生产系统截图或实时监控。</p>
          </div>
          <ProjectVisual project={project} />
        </section>

        <section class="case-decisions" id="case-decisions" aria-labelledby="case-decisions-title">
          <div class="case-section-title">
            <div><h2 id="case-decisions-title">真正需要处理的细节</h2></div>
            <p>不只记录功能，也记录影响维护和业务可靠性的取舍。</p>
          </div>
          <div class="case-decision-list">
            {project.decisions.map((decision, index) => (
              <article>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div><h3>{decision.title}</h3><p>{decision.description}</p></div>
              </article>
            ))}
          </div>
        </section>

        <section class="case-summary" id="case-summary" aria-labelledby="case-summary-title">
          <h2 id="case-summary-title">公开与技术边界</h2>
          <ul>{project.boundaries.map((item) => <li>{item}</li>)}</ul>
        </section>

        <section class="case-resources" id="case-resources" aria-labelledby="case-resources-title">
          <div class="case-section-title">
            <div><h2 id="case-resources-title">继续了解这个项目</h2></div>
            <p>这里提供案例、公开文章或源码资料，不包含内部生产系统地址。</p>
          </div>
          <div class="case-resource-list">
            {linked.map((link) => (
              <a href={link.url} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
                <div><strong>{link.title}</strong><span>{link.description}</span></div><span aria-hidden="true">↗</span>
              </a>
            ))}
            {linked.length === 0 && <p>当前案例仅提供已核实的项目原理说明，暂无公开源码或演示地址。</p>}
          </div>
        </section>

      </div>
    </div>
  </main>
</SiteLayout>

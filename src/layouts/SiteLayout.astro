---
import '../styles/global.css';
import '../styles/site-shell.css';
import HomeIntroState from '../components/HomeIntroState.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteMeta } from '../data/site';
import { withBase } from '../utils/paths';

interface Props {
  title?: string;
  active?: 'home' | 'articles' | 'series' | 'projects' | 'about';
  description?: string;
  standalone?: boolean;
}

const {
  title = siteMeta.siteName,
  active = 'home',
  description = siteMeta.siteDescription,
  standalone = false,
} = Astro.props;
const pageTitle = title === siteMeta.siteName ? title : `${title} | ${siteMeta.siteName}`;
const pageKind = standalone ? 'standalone' : active === 'home' ? 'home' : 'content';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN" data-page-kind={pageKind}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {standalone && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f5f4ef" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="256x256" href={withBase('/favicon.png?v=5')} />
    <link rel="stylesheet" href={withBase('/fonts/typography.css')} />
    <link rel="alternate" type="application/rss+xml" title={siteMeta.siteName} href={withBase(siteMeta.rssPath)} />
    <script is:inline>
      (function () {
        var theme = 'light';
        var style = 'visual-system';
        try {
          var saved = localStorage.getItem('theme');
          // The old homepage had its own preference. Migrate it once when no shared preference exists.
          if (!saved) saved = localStorage.getItem('home-redesign-1-theme');
          theme = saved === 'dark' ? 'dark' : 'light';
          var savedStyle = localStorage.getItem('styleTheme');
          if (['classic', 'index-gradient', 'visual-system', 'clarity'].includes(savedStyle)) style = savedStyle;
          if (theme === 'dark') style = 'classic';
          else if (style === 'classic') style = 'visual-system';
        } catch (error) {}
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.styleTheme = style;
        document.querySelector('meta[name="theme-color"]').content = theme === 'dark' ? '#18201e' : style === 'index-gradient' ? '#f5eee2' : style === 'clarity' ? '#f6f8fc' : '#f5f4ef';
      })();
    </script>
    <HomeIntroState pageKind={pageKind} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#site-content">跳到正文</a>
    <div class="site-shell">
      <SiteHeader active={active} />
      <div id="site-content" tabindex="-1" data-pagefind-body>
        <slot />
      </div>
      <SiteFooter />
    </div>
    <style is:inline>
      .has-copy-code {
        padding-top: 42px;
        position: relative;
      }

      .hero-code.has-copy-code {
        padding-top: 0;
      }

      .terminal-panel {
        position: relative;
      }

      .terminal-panel > .copy-code-button {
        background: transparent;
        border-color: transparent;
        border-radius: 6px;
        color: #64748b;
        height: 28px;
        right: 10px;
        top: 7px;
        width: 28px;
        z-index: 2;
      }

      .copy-code-button {
        align-items: center;
        background: rgba(15, 23, 42, 0.72);
        border: 1px solid rgba(148, 163, 184, 0.42);
        border-radius: 999px;
        color: #cbd5e1;
        cursor: pointer;
        display: inline-flex;
        height: 30px;
        justify-content: center;
        padding: 0;
        position: absolute;
        right: 12px;
        top: 10px;
        width: 30px;
      }

      .copy-code-button svg {
        height: 15px;
        width: 15px;
      }

      .copy-code-button:hover {
        background: rgba(30, 41, 59, 0.88);
        color: #ffffff;
      }

      .terminal-panel > .copy-code-button:hover {
        background: rgba(148, 163, 184, 0.1);
        border-color: rgba(148, 163, 184, 0.16);
        color: #cbd5e1;
      }

      .copy-code-button.is-copied {
        color: #ffffff;
      }

      .terminal-panel > .copy-code-button.is-copied {
        background: rgba(34, 197, 94, 0.12);
        color: #86efac;
      }
    </style>
    <script is:inline>
      (function () {
        document.querySelectorAll('pre > code').forEach(function (code) {
          var pre = code.parentElement;
          if (!pre || pre.closest('.mermaid-card')) return;
          var copyHost = pre.closest('.terminal-panel') || pre;
          if (copyHost.querySelector('[data-copy-code]')) return;
          pre.classList.add('has-copy-code');

          var button = document.createElement('button');
          button.type = 'button';
          button.className = 'copy-code-button';
          button.dataset.copyCode = '';
          var copyIcon = '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
          var copiedIcon = '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>';
          button.innerHTML = copyIcon;
          button.setAttribute('aria-label', '复制代码');
          button.setAttribute('title', '复制代码');

          button.addEventListener('click', function () {
            navigator.clipboard.writeText(code.innerText).then(function () {
              button.innerHTML = copiedIcon;
              button.classList.add('is-copied');
              button.setAttribute('aria-label', '已复制');
              button.setAttribute('title', '已复制');
              window.setTimeout(function () {
                button.innerHTML = copyIcon;
                button.classList.remove('is-copied');
                button.setAttribute('aria-label', '复制代码');
                button.setAttribute('title', '复制代码');
              }, 1400);
            });
          });

          copyHost.appendChild(button);
        });
      })();
    </script>
  </body>
</html>

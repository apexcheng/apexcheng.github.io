---
import { getCollection } from 'astro:content';
import { seriesMetaList } from '../../data/series';
import ContentViewTabs from '../../components/ContentViewTabs.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { withBase } from '../../utils/paths';

const posts = (await getCollection('posts')).filter((post) => !post.data.draft && !post.data.private && !post.data.archived);
const seriesList = seriesMetaList
  .map((series) => {
    const seriesPosts = posts
      .filter((post) => post.data.series === series.id)
      .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));

    return {
      ...series,
      posts: seriesPosts,
      postCount: seriesPosts.length,
      totalMinutes: seriesPosts.reduce((sum, post) => sum + post.data.minutes, 0),
    };
  })
  .filter((series) => series.postCount > 0)
  .sort((a, b) => a.order - b.order);
---

<SiteLayout title="专题系列" active="series">
  <main class="page-content series-directory">
    <header class="series-directory-heading">
      <h1 class="page-title">文章与系列</h1>
      <ContentViewTabs active="series" />
    </header>

    <div class="series-directory-layout">
      <nav class="series-directory-index" aria-label="选择专题">
        {seriesList.map((series, index) => (
          <a href={withBase(`/series/${series.id}/`)} data-series-option={series.id}
            aria-current={index === 0 ? 'true' : undefined}
            aria-controls={`series-preview-${series.id}`}>
            <span>{series.title}</span>
            <small>{series.postCount} 篇 · 约 {series.totalMinutes} 分钟</small>
          </a>
        ))}
      </nav>

      <section aria-label="专题预览">
        {seriesList.map((series, index) => (
          <article class="series-preview" data-series-preview={series.id} id={`series-preview-${series.id}`} hidden={index !== 0}>
            <header class="series-preview-heading">
              <p class="series-preview-meta">{series.postCount} 篇文章 · 约 {series.totalMinutes} 分钟</p>
              <h2>{series.title}</h2>
              <p>{series.description}</p>
              <div class="series-preview-actions">
                <a class="series-preview-start" href={withBase(`/articles/${series.posts[0].slug}/`)}>开始阅读 <span aria-hidden="true">→</span></a>
                <a href={withBase(`/series/${series.id}/`)}>完整路线</a>
                {('resource' in series || 'extraResource' in series) && <a href={withBase(`/series/${series.id}/#series-resources`)}>练习与考核资源 <span aria-hidden="true">↗</span></a>}
              </div>
            </header>
            <h3 class="series-preview-chapters-title">章节目录</h3>
            <ol class="series-preview-chapters">
              {series.posts.map((post, postIndex) => (
                <li>
                  <a href={withBase(`/articles/${post.slug}/`)}>
                    <span class="series-preview-chapter-order" aria-hidden="true">{String(postIndex + 1).padStart(2, '0')}</span>
                    <span>{post.data.title}</span>
                    <small>{post.data.minutes} 分钟</small>
                  </a>
                </li>
              ))}
            </ol>
          </article>
        ))}
      </section>
    </div>
  </main>
</SiteLayout>

<style>
  .series-directory { max-width: 1480px; }
  .series-directory-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 24px; margin-bottom: 20px; }
  .series-directory-heading h1 { margin: 0; }
  .series-directory-layout {
    display: grid;
    grid-template-columns: minmax(238px, .32fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(24px, 3vw, 48px);
    border-top: 1px solid var(--line);
    padding-top: 19px;
  }
  .series-directory-index { position: sticky; top: 96px; display: grid; gap: 5px; }
  .series-directory-index a {
    display: grid; gap: 3px; min-height: 62px; padding: 11px 14px; border-radius: 6px;
    border: 1px solid transparent; font-size: 15px; font-weight: 680; color: var(--ink);
  }
  .series-directory-index a:hover { color: var(--blue); background: var(--paper-soft); }
  .series-directory-index a[aria-current] { color: var(--blue); background: var(--paper); border-color: var(--line); border-inline-start: 3px solid var(--blue); }
  .series-directory-index small, .series-preview-meta { color: var(--muted); font-size: 12px; font-weight: 500; }
  .series-preview { border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper); overflow: clip; min-height: 485px; }
  .series-preview[hidden] { display: none; }
  .series-preview-heading { padding: clamp(22px, 3vw, 36px); background: color-mix(in srgb, var(--paper) 88%, var(--blue)); border-bottom: 1px solid var(--line); }
  .series-preview-meta { margin: 0 0 6px; }
  .series-preview-heading h2 { margin: 0; font-size: clamp(25px, 3vw, 38px); line-height: 1.25; font-weight: 720; text-wrap: balance; }
  .series-preview-heading h2 + p { max-width: 68ch; margin: 10px 0 17px; color: var(--muted); font-size: 15px; line-height: 1.7; }
  .series-preview-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; }
  .series-preview-actions a { color: var(--blue); font-size: 14px; font-weight: 690; min-height: 42px; display: inline-flex; align-items: center; gap: 9px; }
  .series-preview-actions .series-preview-start { background: var(--ink); color: var(--paper); border-radius: 6px; padding: 0 13px; }
  .series-preview-actions a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .series-preview-chapters-title { margin: 17px clamp(22px, 3vw, 36px) 4px; font-size: 15px; }
  .series-preview-chapters { list-style: none; margin: 0; padding: 0 clamp(22px, 3vw, 36px) 20px; }
  .series-preview-chapters li + li { border-top: 1px solid var(--line-soft); }
  .series-preview-chapters a { display: grid; align-items: baseline; grid-template-columns: 28px minmax(0, 1fr) auto; gap: 9px; padding: 12px 3px; font-size: 15px; line-height: 1.45; }
  .series-preview-chapters a:hover { color: var(--blue); text-decoration: underline; text-underline-offset: 5px; }
  .series-preview-chapters small { font-size: 12px; color: var(--muted); }
  .series-preview-chapter-order { font-size: 12px; color: var(--blue); font-variant-numeric: tabular-nums; }
  @media (max-width: 800px) {
    .series-directory-layout { grid-template-columns: 1fr; gap: 14px; }
    .series-directory-index { position: static; display: flex; gap: 6px; overflow-x: auto; padding: 4px; }
    .series-directory-index a { flex: 0 0 auto; max-width: 260px; }
    .series-preview { min-height: 0; }
  }
</style>

<script>
  const options = [...document.querySelectorAll<HTMLAnchorElement>('[data-series-option]')];
  const previews = [...document.querySelectorAll<HTMLElement>('[data-series-preview]')];

  function selectSeries(id: string) {
    options.forEach(option => {
      if (option.dataset.seriesOption === id) option.setAttribute('aria-current', 'true');
      else option.removeAttribute('aria-current');
    });
    previews.forEach(preview => { preview.hidden = preview.dataset.seriesPreview !== id; });
  }

  function restoreSelection() {
    const id = new URLSearchParams(location.search).get('series');
    const option = options.find(option => option.dataset.seriesOption === id) ?? options[0];
    if (option?.dataset.seriesOption) selectSeries(option.dataset.seriesOption);
  }

  options.forEach(option => {
    option.addEventListener('click', event => {
      if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const id = option.dataset.seriesOption;
      if (!id || option.hasAttribute('aria-current')) {
        event.preventDefault();
        return;
      }
      event.preventDefault();
      const url = new URL(location.href);
      url.searchParams.set('series', id);
      history.pushState(history.state, '', url);
      selectSeries(id);
    });
  });
  window.addEventListener('popstate', restoreSelection);
  restoreSelection();
</script>

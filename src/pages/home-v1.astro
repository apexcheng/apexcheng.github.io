---
import { getCollection } from 'astro:content';
import {
  ArrowRight,
  BookOpen,
  CodeXml,
  Coffee,
  Image,
} from '@lucide/astro';
import HomeDiscovery from '../components/HomeDiscovery.astro';
import HomeIntroState from '../components/HomeIntroState.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { categoryMetaList } from '../data/categories';
import { projects } from '../data/projects';
import { seriesMetaList } from '../data/series';
import { siteMeta } from '../data/site';
import { withBase } from '../utils/paths';
import { selectHomeReading } from '../utils/home-reading';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft && !post.data.private && !post.data.archived)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const { recommended, recent, more } = selectHomeReading(posts);
const visualPosts = posts.filter((post) => post.data.category === '视觉实验室').slice(0, 3);
const seriesOrder = ['excel-functions', 'yingdao-agent-development', 'personal-blog'];
const seriesNotes = {
  'excel-functions': '从函数知识地图到真实表格，把抽象语法变成可以观察的数据路径。',
  'yingdao-agent-development': '从页面探测、代码编写到同步验证，记录 Agent 如何参与真实交付。',
  'personal-blog': '拆解内容、代码与发布链路，理解个人知识系统如何持续运转。',
};

const featuredSeries = seriesOrder
  .map((seriesId) => seriesMetaList.find((series) => series.id === seriesId))
  .filter((series) => series !== undefined)
  .map((series) => ({
    ...series,
    postCount: posts.filter((post) => post.data.series === series.id).length,
    note: seriesNotes[series.id],
  }));

const categoryCounts = categoryMetaList.map(
  (category) => posts.filter((post) => post.data.category === category.name).length,
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', {
    month: '2-digit',
    day: '2-digit',
  }).format(date);
---

<!doctype html>
<html lang="zh-CN" data-theme="light" data-style-theme="clarity" class="design-one-page">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="黄撑的个人博客视觉晶蓝主题首页，以清透的蓝青紫视觉记录生活思考、技术实践与项目经验。"
    />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f6f8fc" />
    <link rel="icon" type="image/png" sizes="256x256" href={withBase('/favicon.png?v=5')} />
    <link rel="stylesheet" href={withBase('/fonts/typography.css')} />
    <title>{`视觉晶蓝 | ${siteMeta.siteName}`}</title>
    <script is:inline>
      try {
        var savedTheme = localStorage.getItem('theme');
        var isDark = savedTheme === 'dark'
          || (!savedTheme && localStorage.getItem('home-redesign-1-theme') === 'dark');
        document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
        document.documentElement.dataset.styleTheme = isDark ? 'classic' : 'clarity';
      } catch (error) {
        document.documentElement.dataset.theme = 'light';
      }
      document.documentElement.classList.add('js');
    </script>
    <HomeIntroState pageKind="home" />
  </head>
  <body data-pagefind-ignore>
    <a class="skip-link" href="#site-content">跳到正文</a>
    <SiteHeader active="home" homePath="/home-v1/" />

    <main id="site-content" tabindex="-1">
      <section class="hero" id="top">
        <div class="hero-inner">
          <HomeDiscovery variant="blue" {recommended} {recent}>
            <div class="hero-copy">
              <p class="hero-kicker">你好，我是黄撑</p>
              <h1>把复杂技术，<span class="accent-text">做成用得上的方法。</span></h1>
              <p class="hero-lead">在电商运营中找问题，用数据和自动化解决它，再把过程写下来。</p>
            </div>
          </HomeDiscovery>
        </div>
      </section>

      <section class="content-section topics-section" id="topics">
        <div class="topics-heading" data-reveal>
          <h2>按主题浏览</h2>
          <a href={withBase('/articles/')}>
            全部文章
            <ArrowRight size={15} stroke-width={2} />
          </a>
        </div>

        <div class="topic-grid">
          {categoryMetaList.map((category, index) => (
            <a
              class:list={['topic-card', `topic-${index + 1}`]}
              href={withBase(`/articles/category/${encodeURIComponent(category.name)}/`)}
              data-reveal
            >
              <div class="topic-card-head">
                <span class="topic-icon" aria-hidden="true">
                  {index === 0 && <Coffee size={23} stroke-width={1.8} />}
                  {index === 1 && <CodeXml size={23} stroke-width={1.8} />}
                  {index === 2 && <BookOpen size={23} stroke-width={1.8} />}
                  {index === 3 && <Image size={23} stroke-width={1.8} />}
                </span>
                <h3>{category.name}</h3>
                <ArrowRight size={19} stroke-width={1.8} />
              </div>
              <p>{category.description.split('\n')[0]}</p>
              <span class="topic-meta">{categoryCounts[index]} 篇内容 · 持续更新</span>
            </a>
          ))}
        </div>
      </section>

      <section class="content-section series-section" id="series">
        <div class="section-head" data-reveal>
          <div>
            <p class="section-label">精选系列</p>
            <h2>不是零散文章，而是一条完整路线。</h2>
          </div>
          <p>从整体认识进入案例和工具，沿着清晰顺序逐步阅读。</p>
          <a href={withBase('/series/')}>查看全部系列</a>
        </div>

        <div class="series-grid">
          {featuredSeries.map((series, index) => (
            <a
              class:list={['series-card', index === 0 && 'series-card-featured']}
              href={withBase(`/series/${series.id}/`)}
              data-reveal
            >
              <div class="series-number">{String(index + 1).padStart(2, '0')}</div>
              <div class="series-copy">
                <span>{series.postCount} 篇文章</span>
                <h3>{series.title}</h3>
                <p>{series.note}</p>
              </div>
              <div class="series-progress" aria-hidden="true"><i></i></div>
            </a>
          ))}
        </div>
      </section>

      <section class="content-section lab-section" id="visual-lab">
        <div class="section-head" data-reveal>
          <div>
            <p class="section-label">视觉实验室</p>
            <h2>让公式、流程和代码真正看得见。</h2>
          </div>
          <p>用组件、图表与动效寻找比长段文字更直观的讲解方式。</p>
          <a href={withBase(`/articles/category/${encodeURIComponent('视觉实验室')}/`)}>查看全部实验</a>
        </div>

        <div class="lab-grid">
          {visualPosts.map((post, index) => (
            <a
              class:list={['lab-card', `lab-card-${index + 1}`]}
              href={withBase(`/articles/${post.slug}/`)}
              data-reveal
            >
              <div class="lab-visual" aria-hidden="true">
                {index === 0 && (
                  <div class="formula-demo">
                    <div class="formula-input"><span>fx</span><b>=XLOOKUP(E2,A:A,C:C)</b></div>
                    <div class="sheet-demo">
                      <span>A</span><span>B</span><span>C</span><span>D</span>
                      <i></i><i></i><i></i><i></i>
                      <i></i><i class="hit"></i><i></i><i></i>
                      <i></i><i></i><i class="hit"></i><i></i>
                    </div>
                    <p>已找到匹配</p>
                  </div>
                )}
                {index === 1 && (
                  <div class="decision-demo">
                    <span>目标</span><i></i><span>判断</span><i></i><span>执行</span><i></i><span>验证</span>
                  </div>
                )}
                {index === 2 && (
                  <div class="layers-demo">
                    <i></i><i></i><i></i>
                    <span>内容结构</span>
                  </div>
                )}
              </div>
              <div class="lab-copy">
                <span>实验 / {String(index + 1).padStart(2, '0')}</span>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="content-section latest-section" id="latest">
        <div class="section-head" data-reveal>
          <div><h2>更多文章</h2></div>
          <a href={withBase('/articles/')}>进入文章库</a>
        </div>

        <div class="latest-list">
          {more.map((post, index) => (
            <a href={withBase(`/articles/${post.slug}/`)} data-reveal>
              <span class="latest-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="latest-category">{post.data.category}</span>
              <h3>{post.data.title}</h3>
              <span class="latest-date">{formatDate(post.data.date)}</span>
              <span class="latest-time">{post.data.minutes} 分钟</span>
            </a>
          ))}
        </div>
      </section>

      <section class="closing-section" data-reveal>
        <div>
          <p>个人知识工作台 · 持续更新</p>
          <h2>继续记录，也继续把事情讲清楚。</h2>
          <span>每一次实践，都可以成为下一次行动的起点。</span>
        </div>
        <div class="closing-actions">
          <a class="button button-primary" href={withBase('/articles/')}>继续阅读</a>
          <a class="button button-secondary" href={siteMeta.githubUrl}>GitHub</a>
        </div>
      </section>
    </main>

    <footer>
      <span>© 2026 黄撑</span>
      <span>技术笔记 / 个人工作台</span>
      <nav aria-label="页脚导航">
        <a href={withBase('/series/')}>系列</a>
        <a href={withBase('/projects/')}>项目</a>
        <a href={withBase(siteMeta.rssPath)}>RSS 订阅</a>
        <a href={withBase('/about/')}>关于</a>
      </nav>
    </footer>

    <script is:inline>
      (function () {
        var reveals = document.querySelectorAll('[data-reveal]');
        if ('IntersectionObserver' in window) {
          var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            });
          }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
          reveals.forEach(function (item) { observer.observe(item); });
        } else {
          reveals.forEach(function (item) { item.classList.add('revealed'); });
        }

      })();
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html.design-one-page) {
    --page: #f6f8fc;
    --home-blue: #2f6bff;
    --home-cyan: #16b8c6;
    scroll-behavior: smooth;
    background: var(--page);
  }

  :global(html.design-one-page[data-theme='dark']) {
    --page: #0e1625;
    --home-blue: #6d94ff;
    --home-cyan: #55d5d7;
  }

  main,
  footer {
    --surface: #ffffff;
    --surface-soft: #eef4ff;
    --surface-warm: #fff6ed;
    --ink: #172033;
    --muted: #5b687b;
    --faint: #7f8da3;
    --line: #dce4f0;
    --line-strong: #cbd7e8;
    --blue: var(--home-blue);
    --blue-deep: #164dc7;
    --cyan: var(--home-cyan);
    --orange: #f29a63;
    --violet: #7c74e8;
    color: var(--ink);
  }

  :global(html[data-theme='dark']) :is(main, footer) {
    --surface: #151f31;
    --surface-soft: #192740;
    --surface-warm: #2a211f;
    --ink: #ecf2fb;
    --muted: #a8b4c7;
    --faint: #8695ad;
    --line: #273750;
    --line-strong: #354965;
    --blue-deep: #9ab4ff;
    --orange: #ffad7d;
    --violet: #aaa2ff;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    background:
      radial-gradient(circle at 76% 8%, color-mix(in srgb, var(--home-blue) 10%, transparent) 0, transparent 28rem),
      radial-gradient(circle at 12% 16%, color-mix(in srgb, var(--home-cyan) 8%, transparent) 0, transparent 26rem),
      var(--page);
    font-family: var(--body-font);
    font-size: 16px;
    line-height: 1.7;
    text-rendering: optimizeLegibility;
    transition: background-color 0.28s ease, color 0.28s ease;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(button),
  :global(input) {
    font: inherit;
  }

  :global(button) {
    color: inherit;
  }

  main {
    overflow: hidden;
  }

  .hero {
    position: relative;
    padding: clamp(38px, 4vw, 68px) clamp(24px, 5vw, 76px);
    border-bottom: 1px solid var(--line);
  }

  .hero::before {
    position: absolute;
    top: 10%;
    right: 2%;
    width: 44vw;
    height: 44vw;
    max-width: 640px;
    max-height: 640px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--blue) 12%, transparent), transparent 68%);
    content: '';
    pointer-events: none;
  }

  .hero-inner,
  .content-section,
  .closing-section,
  footer {
    width: min(1280px, 100%);
    margin-right: auto;
    margin-left: auto;
  }

  .hero-inner {
    position: relative;
  }

  .hero-kicker {
    color: var(--blue-deep);
    font-size: 14px;
    font-weight: 650;
    margin-bottom: 12px;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 20px;
    font-size: clamp(44px, 3.7vw, 66px);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.16;
  }

  h1 span {
    display: block;
  }

  .accent-text {
    background: linear-gradient(100deg, var(--blue-deep), var(--blue) 56%, var(--violet));
    background-clip: text;
    color: transparent;
  }

  .hero-lead {
    max-width: 36rem;
    margin-bottom: 25px;
    color: var(--muted);
    font-size: clamp(16px, 1.35vw, 19px);
    line-height: 1.75;
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .button {
    display: inline-flex;
    min-width: 142px;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 22px;
    border: 1px solid var(--line);
    border-radius: 12px;
    font-size: 14px;
    font-weight: 700;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-2px);
  }

  .button-primary {
    border-color: transparent;
    background: linear-gradient(120deg, var(--blue-deep), var(--blue), var(--cyan));
    box-shadow: 0 14px 34px color-mix(in srgb, var(--blue) 25%, transparent);
    color: #fff;
  }

  .button-secondary {
    background: color-mix(in srgb, var(--surface) 82%, transparent);
  }

  .button-secondary:hover,
  .button-secondary:focus-visible {
    border-color: color-mix(in srgb, var(--blue) 42%, var(--line));
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.7fr) auto;
    gap: 36px;
    align-items: end;
    margin-bottom: 46px;
  }

  .section-label {
    margin-bottom: 10px;
    color: var(--cyan);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .section-head h2,
  .closing-section h2 {
    max-width: 760px;
    margin-bottom: 0;
    font-size: clamp(34px, 4vw, 58px);
    font-weight: 700;
    letter-spacing: -0.012em;
    line-height: 1.18;
  }

  .section-head > p {
    margin-bottom: 3px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
  }

  .section-head > a {
    min-height: 40px;
    align-self: end;
    color: var(--blue);
    font-size: 13px;
    font-weight: 700;
  }

  .topics-section {
    width: 100%;
    max-width: none;
    padding-top: 18px;
    padding-right: clamp(24px, 5vw, 76px);
    padding-bottom: clamp(64px, 6vw, 88px);
    padding-left: clamp(24px, 5vw, 76px);
  }

  .topics-heading,
  .topic-grid {
    width: min(1280px, 100%);
    margin-right: auto;
    margin-left: auto;
  }

  .topics-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 16px;
  }

  .topics-heading h2 {
    margin-bottom: 3px;
    font-size: clamp(24px, 2.2vw, 31px);
    letter-spacing: -0.012em;
    line-height: 1.25;
  }

  .topics-heading p {
    margin-bottom: 0;
    color: var(--muted);
    font-size: 12px;
  }

  .topics-heading a {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 5px;
    color: var(--blue);
    font-size: 12px;
    font-weight: 700;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .topic-card {
    position: relative;
    display: grid;
    min-height: 220px;
    grid-template-rows: auto 1fr auto;
    padding: 18px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: color-mix(in srgb, var(--surface) 94%, transparent);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .topic-card:hover,
  .topic-card:focus-visible {
    border-color: color-mix(in srgb, var(--topic-color) 48%, var(--line));
    box-shadow: 0 22px 48px color-mix(in srgb, var(--topic-color) 13%, transparent);
    transform: translateY(-6px);
  }

  .topic-1 { --topic-color: var(--blue); }
  .topic-2 { --topic-color: var(--cyan); }
  .topic-3 { --topic-color: var(--violet); }
  .topic-4 { --topic-color: var(--orange); }

  .topic-card-head {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto;
    align-items: center;
    gap: 13px;
    margin-bottom: 18px;
  }

  .topic-icon {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border-radius: 14px;
    background: color-mix(in srgb, var(--topic-color) 14%, var(--surface));
    color: var(--topic-color);
  }

  .topic-card-head > svg {
    color: var(--muted);
  }

  .topic-card h3 {
    margin-bottom: 0;
    font-size: 21px;
    letter-spacing: -0.012em;
  }

  .topic-card p {
    margin-bottom: 12px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.65;
  }

  .topic-meta {
    color: var(--faint);
    font-size: 10px;
  }

  .series-section {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface-soft) 58%, transparent);
  }

  .series-grid {
    display: grid;
    grid-template-columns: 1.18fr 0.91fr 0.91fr;
    gap: 18px;
  }

  .series-card {
    display: grid;
    min-height: 330px;
    align-content: space-between;
    gap: 34px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--surface);
    transition: transform 0.24s ease, box-shadow 0.24s ease, border-color 0.24s ease;
  }

  .series-card:hover,
  .series-card:focus-visible {
    border-color: color-mix(in srgb, var(--blue) 42%, var(--line));
    box-shadow: 0 24px 56px color-mix(in srgb, var(--blue) 12%, transparent);
    transform: translateY(-5px);
  }

  .series-card-featured {
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--blue) 10%, var(--surface)), var(--surface) 64%);
  }

  .series-number {
    color: var(--blue);
    font-size: 44px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .series-copy > span {
    color: var(--cyan);
    font-size: 10px;
    font-weight: 700;
  }

  .series-copy h3 {
    margin: 7px 0 12px;
    font-size: clamp(22px, 2.3vw, 32px);
    letter-spacing: -0.04em;
    line-height: 1.28;
  }

  .series-copy p {
    margin-bottom: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.8;
  }

  .series-progress {
    height: 2px;
    overflow: hidden;
    background: var(--line);
  }

  .series-progress i {
    display: block;
    width: 38%;
    height: 100%;
    background: linear-gradient(90deg, var(--cyan), var(--blue), var(--violet));
    transition: width 0.35s ease;
  }

  .series-card:hover .series-progress i {
    width: 100%;
  }

  .lab-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .lab-card {
    display: grid;
    min-height: 560px;
    grid-template-rows: 1fr auto;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--surface);
    transition: transform 0.24s ease, border-color 0.24s ease, box-shadow 0.24s ease;
  }

  .lab-card:hover,
  .lab-card:focus-visible {
    border-color: color-mix(in srgb, var(--cyan) 44%, var(--line));
    box-shadow: 0 24px 60px color-mix(in srgb, var(--ink) 10%, transparent);
    transform: translateY(-5px);
  }

  .lab-card-3 {
    grid-column: 1 / -1;

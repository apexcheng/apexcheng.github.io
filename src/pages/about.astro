---
import { ArrowUpRight } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getProject, projectPath } from '../data/projects';
import { siteMeta } from '../data/site';
import { withBase } from '../utils/paths';
import '../styles/author-profile.css';

const practices = [
  {
    title: '把电商业务做成可维护的系统',
    text: '用 Python 和 Web 后端组织数据、权限与工作流程，减少在工具之间反复核对。',
    project: getProject('hangqiao')!,
  },
  {
    title: '让重复操作可以自动执行',
    text: '用影刀、浏览器操作与脚本处理跨平台任务，同时保留运行结果和异常记录。',
    project: getProject('inventory-rpa')!,
  },
  {
    title: '让 Agent 参与有据可查的工作',
    text: '用知识库、工具调用和真实业务验证，把可复用经验组织进开发过程。',
    project: getProject('yingdao-agent-development')!,
  },
];
const sections = [
  { href: '#about', title: '简介' },
  { href: '#skills', title: '核心技能与项目' },
  { href: '#projects', title: '早期作品' },
  { href: '#journey', title: '成长与经历' },
  { href: '#contact', title: '联系' },
];
---

<SiteLayout title="关于我" active="about">
  <main class="page-content author-profile">
    <div class="author-layout">
      <aside class="author-sidebar">
        <div class="author-sidebar-card">
          <img class="author-avatar" src={withBase('/about-assets/user-520.jpg')} alt="黄撑头像" width="520" height="520" decoding="async" />
          <p>黄撑<small>贵州 · 黔西南</small></p>
          <a href={withBase('/about-assets/resume.docx')} download>下载简历 <ArrowUpRight size={15} aria-hidden="true" /></a>
        </div>
        <nav aria-label="关于页目录">
          {sections.map((section) => <a href={section.href}>{section.title}</a>)}
        </nav>
        <nav class="author-links" aria-label="公开资源">
          <a href={siteMeta.githubUrl}>GitHub 主页</a>
          <a href={siteMeta.projectUrl}>博客项目仓库</a>
          <a href={withBase(siteMeta.rssPath)}>RSS 订阅</a>
        </nav>
      </aside>

      <div class="author-story">
        <header class="author-intro" id="about">
          <p class="author-kicker">Automation Builder · Python / Agent / Practice</p>
          <h1>你好，我是黄撑。</h1>
          <p class="author-lead">我来自贵州黔西南，主攻 Python 后端开发，喜欢用自动化工具解决电商工作里反复遇到的问题，也持续做 Web 项目。这里记录我做过的项目，以及实现过程里的取舍。</p>
          <div class="author-actions">
            <a class="author-primary-link" href={withBase('/projects/')}>查看项目记录 <ArrowUpRight size={16} aria-hidden="true" /></a>
            <a href="#contact">联系我</a>
          </div>
        </header>

        <section class="author-section" id="skills" aria-labelledby="author-skills-title">
          <header class="author-section-title">
            <h2 id="author-skills-title">核心技能与项目</h2>
            <p>Python · 影刀 RPA · Agent · Linux · Java</p>
          </header>
          <div class="author-practices">
            {practices.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <a href={withBase(projectPath(item.project))}>{item.project.title} <ArrowUpRight size={15} aria-hidden="true" /></a>
              </article>
            ))}
          </div>
        </section>
        <section class="author-section" id="projects">
          <div class="author-section-title">
            <h2>早期作品</h2>
          </div>
          <div class="author-early-work">
            <article>
              <p class="author-meta">2022.09 · 后端工程师</p>
              <h3>BrianBlog 博客系统</h3>
              <p>
                一个业务较完整的博客产品，支持多用户在线互动、文章发表与点赞。
                项目中重点实践了 Django 定制、缓存结构设计、搜索与定时任务等能力。
              </p>
              <ul class="author-tech-tags">
                <li>Django</li>
                <li>Whoosh</li>
                <li>APScheduler</li>
                <li>Gunicorn</li>
                <li>Nginx</li>
              </ul>
            </article>

            <article>
              <p class="author-meta">2022.12 - 2023.01</p>
              <h3>Gallery 在线图床</h3>
              <p>围绕图片上传与展示设计的轻量产品，使用 Pillow 做压缩与缩略图处理，降低带宽开销并优化浏览体验。</p>
              <a class="author-text-link" href="https://apexcheng.github.io/gallery/">访问图床 →</a>
              <ul class="author-tech-tags">
                <li>Python</li>
                <li>Pillow</li>
                <li>Image Processing</li>
              </ul>
            </article>

            <article>
              <p class="author-meta">2022.07 · 学院期末考核</p>
              <h3>学生管理系统</h3>
              <p>较早期的 Django 实践项目，完成了数据库增删改查、状态保持等核心业务流程。</p>
              <ul class="author-tech-tags">
                <li>Django</li>
                <li>CRUD</li>
                <li>Session</li>
              </ul>
            </article>

            <article>
              <p class="author-meta">2022.04 · 校园安卓开发大赛</p>
              <h3>Android 软件开发</h3>
              <p>完成登录、注册、好友列表和个人中心等模块设计与开发，并在比赛中获得第二名。</p>
              <ul class="author-tech-tags">
                <li>Android</li>
                <li>Java</li>
                <li>Competition</li>
              </ul>
            </article>
          </div>
        </section>

        <section class="author-section" id="journey">
          <div class="author-section-title">
            <h2>成长与经历</h2>
          </div>
          <div class="author-timeline">
            <article class="author-timeline-item">
              <span class="author-meta">2000 - 2013</span>
              <h3>从山里长大，也从那里学会观察世界</h3>
              <p>原始页面里写了很多童年与迁居的经历，我保留了那种很个人化的叙述感，因为它正是这个主页最独特的部分。</p>
            </article>
            <article class="author-timeline-item">
              <span class="author-meta">2017 - 2020</span>
              <h3>价值观逐渐成形</h3>
              <p>从校园阶段的波动，到开始认真想清楚自己想过怎样的生活，技术也慢慢变成了行动方式。</p>
            </article>
            <article class="author-timeline-item">
              <span class="author-meta">2020 - 现在</span>
              <h3>为梦想持续补课</h3>
              <p>持续用项目补齐能力短板，把每一次练习都尽量做成真实可运行的产品，而不只是作业。</p>
            </article>
          </div>
        </section>

        <section class="author-section" id="contact" aria-labelledby="author-contact-title">
          <header class="author-section-title">
            <h2 id="author-contact-title">联系我</h2>
            <p>欢迎交流 Web 开发、个人项目和业务自动化。</p>
          </header>
          <div class="author-contact">
            <dl>
              <div><dt>邮箱</dt><dd><a href="mailto:chengrip@foxmail.com">chengrip@foxmail.com</a></dd></div>
              <div><dt>电话</dt><dd><a href="tel:+8617302729867">+86 17302729867</a></dd></div>
              <div><dt>微信</dt><dd>CFXXTKAKA</dd></div>
              <div><dt>GitHub</dt><dd><a href={siteMeta.githubUrl}>apexcheng</a></dd></div>
            </dl>
            <figure><img src={withBase('/about-assets/wx.png')} alt="微信二维码" width="1254" height="1254" loading="lazy" decoding="async" /><figcaption>微信二维码</figcaption></figure>
          </div>
        </section>
      </div>
    </div>
  </main>
</SiteLayout>

---
import { ArrowRight, Search } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { portfolioMainId, projectPath, projects } from '../data/projects';
import { withBase } from '../utils/paths';
import '../styles/project-directory.css';

const groups = [
  { id: 'business', label: '业务系统与分析', projects: ['hangqiao', 'hangqiao/ai-table', 'review-analysis-agent'] },
  { id: 'automation', label: '自动化开发', projects: ['inventory-rpa', 'yingdao-agent-development'] },
  { id: 'publishing', label: '内容工程', projects: ['blog-content-engineering'] },
];
---

<SiteLayout title="项目实践" active="projects" description="浏览电商业务系统、跨平台自动化与内容工程案例，了解每个项目要解决的问题、执行流程和已有成果。">
  <main class="page-content project-directory">
    <header class="project-directory-intro">
      <h1>项目实践</h1>
      <p>从电商运营到自动化开发，记录真实项目怎么做、运行到哪一步、有哪些技术取舍。</p>
    </header>

    <div class="project-catalog">
      <aside class="project-index" aria-labelledby="project-index-title">
        <div class="project-index-tools" data-project-tools hidden>
          <label class="project-search">
            <Search size={19} aria-hidden="true" />
            <input type="search" placeholder="搜索项目、场景或技术" aria-label="搜索项目、场景或技术" data-project-search />
          </label>
          <div class="project-filters" role="group" aria-label="按项目方向筛选">
            <button type="button" data-project-filter="" aria-pressed="true">全部</button>
            {groups.map(({ id, label }) => <button type="button" data-project-filter={id} aria-pressed="false">{label}</button>)}
          </div>
        </div>
        <div class="project-index-heading">
          <h2 id="project-index-title">项目索引</h2>
          <span role="status" data-project-count>{projects.length} 个案例</span>
        </div>
        <ul class="project-index-list">
          {projects.map((project) => (
            <li data-project-entry={project.id}
              data-project-group={groups.find((group) => group.projects.includes(project.id))?.id}
              data-project-text={[project.title, project.description, project.type, ...project.tags, ...(project.searchKeywords ?? [])].join(' ').toLocaleLowerCase()}>
              <a href={withBase(projectPath(project))}>
                <span><strong>{project.title}</strong><small>{project.type}</small></span>
                <ArrowRight size={17} aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
        <p data-project-no-match hidden>没有符合条件的项目。<button type="button" data-project-reset>清除筛选</button></p>
      </aside>

      <section class="project-preview" aria-label="项目预览">
        {projects.map((project) => (
          <article class="project-preview-card" data-project-preview={project.id} hidden={project.id !== portfolioMainId}>
            <header>
              <p class="project-preview-category">{project.category}</p>
              <h2>{project.title}</h2>
              <p>{project.description}</p>
              <ul class="project-preview-tags" aria-label="技术标签">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
            </header>
            <div class="project-preview-content">
              <h3>怎么运行</h3>
              <ol class="project-preview-flow">
                {project.flow.map((step) => <li><span>{step.layer}</span><strong>{step.label}</strong></li>)}
              </ol>
              <div class="project-preview-outcome"><h3>已有成果</h3><p>{project.outcomes[0]}</p></div>
              <a class="project-case-link" href={withBase(projectPath(project))}>阅读完整案例 <ArrowRight size={17} aria-hidden="true" /></a>
            </div>
          </article>
        ))}
      </section>
    </div>
  </main>
</SiteLayout>

<script>
  const entries = [...document.querySelectorAll<HTMLElement>('[data-project-entry]')];
  const previews = [...document.querySelectorAll<HTMLElement>('[data-project-preview]')];
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-project-filter]')];
  const input = document.querySelector<HTMLInputElement>('[data-project-search]')!;
  const count = document.querySelector<HTMLElement>('[data-project-count]')!;
  const noMatch = document.querySelector<HTMLElement>('[data-project-no-match]')!;
  const previewLayout = window.matchMedia('(min-width: 1000px)');
  const params = new URLSearchParams(location.search);
  let selected = params.get('case') || '';
  let group = filters.some((filter) => filter.dataset.projectFilter === params.get('group')) ? params.get('group') || '' : '';
  input.value = params.get('q') || '';
  document.querySelector<HTMLElement>('[data-project-tools]')!.hidden = false;

  function refresh(persist = true) {
    const words = input.value.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);
    const matching = entries.filter((entry) => {
      entry.hidden = (group !== '' && entry.dataset.projectGroup !== group) ||
        !words.every((word) => entry.dataset.projectText?.includes(word));
      return !entry.hidden;
    });
    if (!matching.some((entry) => entry.dataset.projectEntry === selected)) {
      selected = matching[0]?.dataset.projectEntry || '';
    }
    filters.forEach((filter) => filter.setAttribute('aria-pressed', String(filter.dataset.projectFilter === group)));
    entries.forEach((entry) => {
      const link = entry.querySelector('a')!;
      if (previewLayout.matches && selected === entry.dataset.projectEntry) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
    previews.forEach((preview) => { preview.hidden = preview.dataset.projectPreview !== selected; });
    count.textContent = matching.length + ' 个案例';
    noMatch.hidden = matching.length > 0;
    if (!persist) return;
    const url = new URL(location.href);
    for (const [key, value] of [['q', input.value.trim()], ['group', group], ['case', selected]]) {
      if (value) url.searchParams.set(key, value);
      else url.searchParams.delete(key);
    }
    history.replaceState(null, '', url);
  }

  filters.forEach((filter) => filter.addEventListener('click', () => {
    group = filter.dataset.projectFilter || '';
    refresh();
  }));
  entries.forEach((entry) => entry.querySelector('a')?.addEventListener('click', (event) => {
    if (!previewLayout.matches || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    selected = entry.dataset.projectEntry || '';
    refresh();
    if (event.detail === 0) document.querySelector<HTMLElement>('.project-preview-card:not([hidden]) .project-case-link')?.focus();
  }));
  input.addEventListener('input', () => refresh());
  document.querySelector('[data-project-reset]')?.addEventListener('click', () => {
    input.value = '';
    group = '';
    refresh();
    input.focus();
  });
  previewLayout.addEventListener('change', () => refresh(false));
  refresh(false);
</script>

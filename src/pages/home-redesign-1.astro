---
import { getCollection } from 'astro:content';
import { ArrowDown, ArrowUpRight, ArrowRight, BookOpen } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { featuredProjectId, getProject, homepageSecondaryIds, projectPath } from '../data/projects';
import { seriesMetaList } from '../data/series';
import { siteMeta } from '../data/site';
import { withBase } from '../utils/paths';
import '../styles/home.css';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft && !post.data.private)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const notes = posts.filter((post) => post.data.category !== '视觉实验室');
const latestPost = notes[0];
const recentPosts = notes.slice(1, 6);
const visualPosts = posts.filter((post) => post.data.category === '视觉实验室').slice(0, 3);
const seriesOrder = ['python-basics', 'excel-functions', 'yingdao-agent-development', 'ecommerce-operation-learning', 'personal-blog'];
const featuredSeries = seriesOrder.map((id) => seriesMetaList.find((series) => series.id === id)!)
  .map((series) => ({ ...series, count: posts.filter((post) => post.data.series === series.id).length }));
const topics = [
  { name: '生活', note: '日常里的观察与判断', label: 'LIFE' },
  { name: '实践', note: '做过，踩过坑，再记录', label: 'PRACTICE' },
  { name: '教程', note: '从理解到亲手完成', label: 'GUIDES' },
  { name: '视觉实验室', note: '让知识有另一种形状', label: 'VISUAL LAB' },
];
const featuredProject = getProject(featuredProjectId);
if (!featuredProject) throw new Error(`首页精选项目未配置：${featuredProjectId}`);
const otherProjects = homepageSecondaryIds.map((id) => {
  const project = getProject(id);
  if (!project) throw new Error(`首页项目未配置：${id}`);
  return project;
});
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Shanghai' }).format(date).replaceAll('/', '.');
const isOfficialHome = Astro.url.pathname === withBase('/');
---

<SiteLayout active="home" title={siteMeta.siteName} description="黄撑的个人博客。记录生活里的判断、项目中的实践，以及技术如何成为日常可用的经验。" standalone={!isOfficialHome}>
  <main class="journal-home">
    <section class="journal-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="journal-eyebrow"><span class="small-rule"></span> 你好，我是黄撑</p>
        <h1 id="home-title">在技术与<br />日常之间，<br /><span>让经验成章。</span></h1>
        <p class="journal-lead">亲手做过的项目，认真想过的问题。<br />把复杂的事弄明白，再把有用的经验留下来。</p>
        <div class="journal-hero-links">
          <a class="ink-link" href="#recent">翻阅笔记 <ArrowDown size={17} /></a>
          <a class="quiet-link" href={withBase('/about/')}>认识一下 <ArrowUpRight size={16} /></a>
        </div>
        <p class="hero-margin-note">生活的观察者，技术的实践者。</p>
      </div>
      {latestPost && <a class="cover-note" href={withBase(`/articles/${latestPost.slug}/`)} aria-label={`阅读最新笔记：${latestPost.data.title}`}>
        <div class="cover-art" aria-hidden="true">
          <div class="cover-art-caption"><span>实践观察站 / OBSERVATORY</span><span>FIELD NOTES · 001</span></div>
          <div class="atlas-art">
            <svg class="atlas-routes" viewBox="0 0 600 350" fill="none" preserveAspectRatio="xMidYMid meet">
              <circle cx="300" cy="178" r="93" stroke="currentColor" stroke-opacity=".25" stroke-dasharray="4 9"/>
              <circle cx="300" cy="178" r="143" stroke="currentColor" stroke-opacity=".10"/>
              <path d="M300 178L131 82M300 178L472 89M300 178L451 289" stroke="currentColor" stroke-opacity=".42" stroke-width="1.5"/>
              <circle cx="131" cy="82" r="3" fill="currentColor"/><circle cx="472" cy="89" r="3" fill="currentColor"/><circle cx="451" cy="289" r="3" fill="currentColor"/>
              <path d="M60 181h40m-20-20v40M513 200h38m-19-19v38" stroke="currentColor" stroke-opacity=".18"/>
            </svg>
            <div class="atlas-core"><span>OBSERVE</span><strong>做过的事</strong><small>连接成自己的知识坐标</small></div>
            <div class="atlas-node atlas-node-note"><span>01 / 最近的笔记</span><strong>{latestPost.data.category}</strong></div>
            <div class="atlas-node atlas-node-project"><span>02 / 真实项目</span><strong>{featuredProject.title}</strong></div>
            <div class="atlas-node atlas-node-series"><span>03 / 持续学习</span><strong>{featuredSeries[0]?.title}</strong></div>
          </div>
          <div class="cover-art-footer"><span>一篇新笔记 · 一个项目 · 一条学习路径</span><ArrowUpRight size={23} /></div>
        </div>
        <div class="cover-note-body">
          <div class="note-meta"><span class="new-note">最新笔记</span><span>{latestPost.data.category}</span><time datetime={latestPost.data.date.toISOString()}>{formatDate(latestPost.data.date)}</time></div>
          <h2>{latestPost.data.title}</h2>
          <p>{latestPost.data.description}</p>
          <span class="cover-read">阅读这篇 · {latestPost.data.minutes} 分钟 <ArrowUpRight size={17} /></span>
        </div>
      </a>}
    </section>

    <nav class="topic-directory" aria-label="按主题阅读">
      {topics.map((topic) => <a href={withBase(`/articles/category/${encodeURIComponent(topic.name)}/`)}>
        <span class="topic-label">{topic.label}</span><span class="topic-name">{topic.name}<ArrowUpRight size={19} /></span><span class="topic-note">{topic.note}</span>
      </a>)}
    </nav>

    <section class="recent-section" id="recent" aria-labelledby="recent-title">
      <div class="section-heading"><div><p class="journal-eyebrow">THE NOTEBOOK</p><h2 id="recent-title">最近写下的</h2></div><a class="text-link" href={withBase('/articles/')}>全部文章 <ArrowUpRight size={18} /></a></div>
      <div class="notebook-layout">
        <div class="note-list">
          {recentPosts.map((post) => <article class="note-row">
            <a href={withBase(`/articles/${post.slug}/`)}>
              <div class="note-row-date"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>{post.data.category}</span></div>
              <div class="note-row-copy"><h3>{post.data.title}</h3><p>{post.data.description}</p><span>{post.data.minutes} 分钟阅读</span></div>
              <ArrowUpRight class="note-row-arrow" size={21} />
            </a>
          </article>)}
        </div>
        <aside class="margin-letter">
          <span class="margin-mark" aria-hidden="true">“</span>
          <h3>好的记录，<br />是留给未来的路标。</h3>
          <p>这里不只放答案。那些绕过的弯路、做过的取舍，以及还在尝试的想法，同样值得留下一笔。</p>
          <div class="letter-signature"><span>黄撑</span><span>写于实践，也写于日常</span></div>
          <a href={withBase(siteMeta.rssPath)}>用 RSS 跟上更新 <ArrowUpRight size={16} /></a>
        </aside>
      </div>
    </section>

    <section class="reading-room" aria-labelledby="series-title">
      <div class="reading-room-intro"><p class="journal-eyebrow">READ A LITTLE DEEPER</p><h2 id="series-title">沿着一条线，<br />读深一点。</h2><p>零散的问题，连起来就是一条路径。<br />选一个主题，从第一篇开始。</p><a class="text-link" href={withBase('/series/')}>全部系列 <ArrowUpRight size={18} /></a><BookOpen size={76} stroke-width={.65} class="reading-room-icon" aria-hidden="true" /></div>
      <div class="series-shelf">
        {featuredSeries.map((series, index) => <a class="series-entry" href={withBase(`/series/${series.id}/`)}>
          <span class="series-number">{String(index + 1).padStart(2, '0')}</span><div><h3>{series.title}</h3><p>{series.description}</p></div><span class="series-count">{series.count} 篇<ArrowUpRight size={18} /></span>
        </a>)}
      </div>
    </section>

    <section class="project-section" aria-labelledby="projects-title">
      <div class="section-heading"><div><p class="journal-eyebrow">FROM NOTES TO TOOLS</p><h2 id="projects-title">也写代码，做些东西。</h2></div><a class="text-link" href={withBase('/projects/')}>查看项目 <ArrowUpRight size={18} /></a></div>
      <div class="home-projects">
        <a class="featured-project" href={withBase(projectPath(featuredProject))}>
          <div class="project-schematic" aria-label="评价分析项目的处理链路：评价采集、责任分析、报告生成、钉钉交付">
            <span class="process-heading">项目实作 / 从反馈到交付</span>
            <ol class="project-process">
              {['评价采集', '责任分析', '报告生成', '钉钉交付'].map((step, index) => <li><small>{String(index + 1).padStart(2, '0')}</small><strong>{step}</strong></li>)}
            </ol>
          </div>
          <span class="project-type">{featuredProject.type}</span><h3>{featuredProject.title}</h3><p>{featuredProject.description}</p><div class="project-foot"><span>{featuredProject.tags.join(' / ')}</span><ArrowUpRight size={23} /></div>
        </a>
        <div class="project-index">
          {otherProjects.map((project) => <a href={withBase(projectPath(project))}><span>{project.type}</span><h3>{project.title}</h3><p>{project.description}</p><ArrowUpRight size={19} /></a>)}
        </div>
      </div>
    </section>

    <section class="lab-section" aria-labelledby="lab-title">
      <div class="lab-intro"><p class="journal-eyebrow">AN OPEN SKETCHBOOK</p><h2 id="lab-title">想法，也可以被看见。</h2><p>图表、代码与页面表达的试验田。</p><a class="text-link" href={withBase('/articles/category/视觉实验室/')}>进入视觉实验室 <ArrowRight size={18} /></a></div>
      <div class="lab-index">{visualPosts.map((post, index) => <a class="lab-entry" href={withBase(`/articles/${post.slug}/`)}>
        <div class="lab-preview" aria-hidden="true">
          <span class="lab-preview-num">EXP / {String(index + 1).padStart(2, '0')}</span>
          <span class="lab-preview-lines"><i></i><i></i><i></i></span>
          <span class="lab-preview-keywords">{post.data.tags.slice(0, 2).join(' / ') || post.data.category}</span>
        </div>
        <div class="lab-entry-copy"><span>{String(index + 1).padStart(2, '0')} / 视觉实验</span><h3>{post.data.title}</h3><p>{post.data.description}</p></div><ArrowUpRight size={18} />
      </a>)}</div>
    </section>
  </main>
</SiteLayout>

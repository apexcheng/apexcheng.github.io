---
import { getCollection } from 'astro:content';
import HomeDiscovery from '../components/HomeDiscovery.astro';
import HomeIntroState from '../components/HomeIntroState.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { seriesMetaList } from '../data/series';
import { siteMeta } from '../data/site';
import { withBase } from '../utils/paths';
import { selectHomeReading } from '../utils/home-reading';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft && !post.data.private && !post.data.archived)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const { recommended, recent, more } = selectHomeReading(posts);
const visualPosts = posts.filter((post) => post.data.category === '视觉实验室').slice(0, 3);

const topics = [
  { name: '生活与思考', description: '日常判断、职场观察和生活实验' },
  { name: '技术', description: 'AI、自动化、开发工具和系统架构' },
  { name: '经营与数据', description: '电商经营、利润核算和数据分析' },
  { name: '视觉实验室', description: '用图解、动效与互动讲清方法' },
].map((topic) => ({
  ...topic,
  href: withBase(`/articles/category/${encodeURIComponent(topic.name)}/`),
  count: posts.filter((post) => post.data.category === topic.name).length,
}));

const featuredSeries = seriesMetaList
  .map((series) => ({
    ...series,
    count: posts.filter((post) => post.data.series === series.id).length,
    href: withBase(`/series/${series.id}/`),
  }))
  .filter((series) => series.count > 0)
  .slice(0, 3);

const formatDate = (date: Date) => date.toISOString().slice(0, 10);
const paperTexture = withBase('/images/home-redesign-2/paper-texture.webp');
---

<!doctype html>
<html lang="zh-CN" data-theme="light" data-style-theme="visual-system" class="paper-page">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="黄撑的个人博客，以纸张手记的方式记录生活判断、技术实践、经营与数据，以及不断整理的方法。"
    />
    <meta name="theme-color" content="#f8f4eb" />
    <link rel="icon" type="image/png" sizes="256x256" href={withBase('/favicon.png?v=5')} />
    <link rel="canonical" href={new URL(withBase('/'), Astro.site)} />
    <link rel="stylesheet" href={withBase('/fonts/typography.css')} />
    <title>纸张手记 | {siteMeta.siteName}</title>
    <script is:inline data-visual-blue-home={withBase('/home-v1/')}>
      document.documentElement.classList.add('js');
      (function () {
        var script = document.currentScript;
        var visualBlueHome = script ? script.dataset.visualBlueHome : '';
        try {
          var homeStyle = localStorage.getItem('homeStyle');
          if (homeStyle !== 'paper-notes' && homeStyle !== 'visual-blue') {
            homeStyle = localStorage.getItem('styleTheme') === 'clarity' ? 'visual-blue' : 'paper-notes';
            localStorage.setItem('homeStyle', homeStyle);
          }

          if (homeStyle === 'visual-blue' && visualBlueHome) {
            var target = new URL(visualBlueHome, window.location.origin);
            target.search = window.location.search;
            target.hash = window.location.hash;
            window.location.replace(target.href);
            return;
          }

          var sharedTheme = localStorage.getItem('theme');
          var isNight = sharedTheme === 'dark'
            || (!sharedTheme && localStorage.getItem('home-redesign-2-theme') === 'night');
          document.documentElement.dataset.theme = isNight ? 'dark' : 'light';
          document.documentElement.dataset.styleTheme = isNight ? 'classic' : 'visual-system';
        } catch (error) {}
      })();
    </script>
    <HomeIntroState pageKind="home" />
  </head>
  <body
    data-pagefind-ignore
    style={`--paper-texture: url("${paperTexture}");`}
  >
    <a class="skip-link" href="#site-content">跳到正文</a>
    <SiteHeader active="home" />

    <main id="site-content" tabindex="-1">
      <section class="paper-hero shell" id="top">
        <HomeDiscovery variant="paper" {recommended} {recent}>
          <div class="hero-copy">
            <p class="hand-note">黄撑的实践手记</p>
            <h1>把真实问题拆开，<br /><span>把做法写清楚。</span></h1>
            <p class="hero-lead">写下电商运营中的判断、自动化项目里的取舍，以及可以照着做的方法。</p>
          </div>
        </HomeDiscovery>
      </section>

      <section class="direction-section shell" aria-labelledby="direction-title">
        <div class="section-heading">
          <h2 id="direction-title">按主题浏览</h2>
        </div>
        <div class="direction-board">
          {topics.map((topic) => (
            <a class="direction-topic" href={topic.href}>
              <h3>{topic.name} <span aria-hidden="true">↗</span></h3>
              <p>{topic.description}</p>
              <small>{topic.count} 篇</small>
            </a>
          ))}
        </div>
      </section>

      <section class="series-section shell" id="series">
        <div class="section-heading" data-reveal>
          <div>
            <p class="hand-note">把零散内容，整理成一条路线</p>
            <h2>正在形成的阅读系列</h2>
          </div>
          <a href={withBase('/series/')}>查看全部系列 <span aria-hidden="true">→</span></a>
        </div>

        <div class="series-grid">
          {featuredSeries.map((series, index) => (
            <a class:list={['series-folder', index === 1 && 'cyan', index === 2 && 'blue']} href={series.href} data-reveal>
              <div class="folder-tab">系列 {String(index + 1).padStart(2, '0')}</div>
              <div class="folder-meta">
                <span>{series.count} 篇文章</span>
                <span>持续更新</span>
              </div>
              <h3>{series.title}</h3>
              <p>{series.description}</p>
              <span class="folder-action">打开阅读路线 <i aria-hidden="true">→</i></span>
            </a>
          ))}
        </div>
      </section>

      <section class="lab-section shell" id="visual-lab">
        <div class="section-heading" data-reveal>
          <div>
            <p class="hand-note cyan-note">把复杂关系，画到一眼能懂</p>
            <h2>最近的视觉实验</h2>
          </div>
          <a href={topics[3].href}>进入视觉实验室 <span aria-hidden="true">→</span></a>
        </div>

        <div class="lab-list">
          {visualPosts.map((post, index) => (
            <a class="lab-row" href={withBase(`/articles/${post.slug}/`)} data-reveal>
              <span class="lab-index">0{index + 1}</span>
              <div class="lab-copy">
                <span>{post.data.tags.slice(0, 2).join(' · ')}</span>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
              <div class:list={['lab-swatch', index === 1 && 'coral', index === 2 && 'ink']} aria-hidden="true">
                <i></i><i></i><i></i>
              </div>
              <span class="lab-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>

      <section class="archive-section shell" id="latest">
        <div class="section-heading" data-reveal>
          <div>
            <p class="hand-note">最近写下来的内容</p>
            <h2>更多文章</h2>
          </div>
          <a href={withBase('/articles/')}>浏览全部文章 <span aria-hidden="true">→</span></a>
        </div>

        <div class="archive-list">
          {more.map((post, index) => (
            <a class="archive-row" href={withBase(`/articles/${post.slug}/`)} data-reveal>
              <span class="archive-no">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <span class="archive-category">{post.data.category}</span>
                <h3>{post.data.title}</h3>
              </div>
              <p>{post.data.description}</p>
              <time datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="closing-section shell" data-reveal>
        <p>持续记录真实问题、判断过程和最后做法。</p>
        <a href={withBase('/articles/')}>浏览文章库 <span aria-hidden="true">→</span></a>
      </section>
    </main>

    <footer class="paper-footer">
      <div class="shell">
        <span>© 2026 黄撑</span>
        <span>个人记录 · 真实实践 · 持续整理</span>
        <nav aria-label="页脚导航">
          <a href={withBase(siteMeta.rssPath)}>RSS 订阅</a>
          <a href={siteMeta.githubUrl}>GitHub ↗</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var revealItems = document.querySelectorAll('[data-reveal]');
        if (reducedMotion || !('IntersectionObserver' in window)) {
          revealItems.forEach(function (item) { item.classList.add('visible'); });
        } else {
          var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            });
          }, { threshold: 0.12 });
          revealItems.forEach(function (item) { observer.observe(item); });
        }
      })();
    </script>
  </body>
</html>

<style>
  :root {
    --home-background: #f8f4eb;
  }

  :root[data-theme='dark'] {
    --home-background: #171b22;
  }

  main,
  .paper-footer {
    --paper: var(--home-background);
    --paper-soft: #fcfaf5;
    --paper-card: rgba(255, 253, 248, 0.88);
    --ink: #111c2e;
    --ink-soft: #5d6270;
    --line: rgba(82, 70, 53, 0.2);
    --line-strong: rgba(82, 70, 53, 0.34);
    --blue: #0667e8;
    --on-blue: #fff;
    --blue-soft: #55a5e4;
    --cyan: #35b8c2;
    --coral: #f06f45;
    --shadow: 0 18px 50px rgba(70, 55, 37, 0.09);
    --serif: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", Georgia, serif;
    --sans: Inter, "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
    --hand: "Kaiti SC", "STKaiti", KaiTi, var(--serif);
  }

  :root[data-theme='dark'] :is(main, .paper-footer) {
    --paper-soft: #20252d;
    --paper-card: rgba(35, 40, 48, 0.92);
    --ink: #f3eee3;
    --ink-soft: #b9b4aa;
    --line: rgba(235, 225, 207, 0.16);
    --line-strong: rgba(235, 225, 207, 0.3);
    --blue: #65a7ff;
    --on-blue: #171b22;
    --blue-soft: #79bde8;
    --cyan: #58cbd0;
    --coral: #ff8e68;
    --shadow: 0 18px 50px rgba(0, 0, 0, 0.28);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background-color: var(--home-background);
    background-image: var(--paper-texture);
    background-repeat: repeat;
    background-size: 900px auto;
    margin: 0;
    min-width: 320px;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  main {
    color: var(--ink);
    font-family: var(--serif);
  }

  :root[data-theme='dark'] body {
    background-blend-mode: multiply;
    background-image: none;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input {
    font: inherit;
  }

  button {
    color: inherit;
  }

  .shell {
    margin: 0 auto;
    max-width: 1370px;
    padding-left: 44px;
    padding-right: 44px;
    width: 100%;
  }

  .paper-hero {
    padding-block: clamp(38px, 4.5vw, 72px);
  }

  .hand-note {
    color: var(--coral);
    font-family: var(--hand);
    font-size: 20px;
    letter-spacing: 0.11em;
    margin: 0 0 16px;
    transform: rotate(-1.2deg);
  }

  .hero-copy h1 {
    font-size: clamp(45px, 4.1vw, 68px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.26;
    margin: 0;
  }

  .hero-copy h1 span {
    display: inline-block;
    position: relative;
  }

  .hero-copy h1 span::after {
    background: var(--blue-soft);
    bottom: 2px;
    content: '';
    height: 3px;
    left: -8px;
    opacity: 0.55;
    position: absolute;
    transform: rotate(-0.7deg);
    width: calc(100% + 18px);
  }

  .hero-lead {
    color: var(--ink-soft);
    font-size: 19px;
    line-height: 1.85;
    margin: 21px 0 0;
  }

  .section-heading > a {
    color: var(--blue);
  }

  .direction-section {
    padding-bottom: 60px;
  }

  .direction-section .section-heading {
    margin-bottom: 15px;
  }

  .direction-board {
    background: var(--paper-card);
    border-block: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .direction-topic {
    padding: 20px 22px;
  }

  .direction-topic + .direction-topic {
    border-left: 1px solid var(--line);
  }

  .direction-topic h3 {
    display: flex;
    font-size: 21px;
    justify-content: space-between;
    margin: 0 0 6px;
  }

  .direction-topic h3 span,
  .direction-topic:hover h3,
  .direction-topic:focus-visible h3 {
    color: var(--blue);
  }

  .direction-topic p,
  .direction-topic small {
    color: var(--ink-soft);
    font: 400 13px/1.55 var(--sans);
  }

  .direction-topic p {
    margin: 0 0 11px;
  }

  .series-section,
  .lab-section,
  .archive-section {
    border-top: 1px solid var(--line);
    padding-bottom: 112px;
    padding-top: 96px;
  }

  .section-heading {
    align-items: end;
    display: flex;
    justify-content: space-between;
    margin-bottom: 48px;
  }

  .section-heading .hand-note {
    font-size: 18px;
    margin-bottom: 12px;
  }

  .section-heading h2 {
    font-size: clamp(34px, 3vw, 46px);
    letter-spacing: -0.03em;
    margin: 0;
  }

  .section-heading > a {
    font-size: 15px;
    padding-bottom: 7px;
  }

  .series-grid {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .series-folder {
    background: color-mix(in srgb, var(--paper-card) 93%, transparent);
    border: 1px solid var(--line);
    box-shadow: 0 14px 40px rgba(75, 58, 36, 0.07);
    min-height: 330px;
    padding: 42px 33px 31px;
    position: relative;
    transition: box-shadow 0.26s ease, transform 0.26s ease;
  }

  .series-folder::before {
    background: var(--coral);
    content: '';
    height: 3px;
    left: 0;
    position: absolute;
    right: 0;
    top: 0;
  }

  .series-folder.cyan::before {
    background: var(--cyan);
  }

  .series-folder.blue::before {
    background: var(--blue);
  }

  .series-folder:hover {
    box-shadow: 0 20px 48px rgba(75, 58, 36, 0.12);
    transform: translateY(-4px) rotate(-0.2deg);
  }

  .folder-tab {
    background: var(--paper-card);
    border: 1px solid var(--line);
    border-bottom: 0;
    font-family: var(--hand);
    font-size: 14px;
    left: 26px;
    padding: 7px 18px;
    position: absolute;
    top: -32px;
  }

  .folder-meta {
    color: var(--ink-soft);
    display: flex;
    font-family: var(--sans);
    font-size: 11px;
    justify-content: space-between;
  }

  .series-folder h3 {
    font-size: 26px;
    line-height: 1.45;
    margin: 31px 0 15px;
  }

  .series-folder p {
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 1.8;
    margin: 0;
  }

  .folder-action {
    bottom: 31px;
    color: var(--blue);
    font-size: 14px;
    left: 33px;
    position: absolute;
  }

  .folder-action i {
    display: inline-block;
    font-style: normal;
    margin-left: 5px;
    transition: transform 0.2s ease;
  }

  .series-folder:hover .folder-action i {
    transform: translateX(4px);
  }

  .cyan-note {
    color: var(--cyan);
  }

  .lab-list {
    border-top: 1px solid var(--line-strong);
  }

  .lab-row {
    align-items: center;
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 28px;
    grid-template-columns: 46px minmax(0, 1.4fr) 280px 24px;
    min-height: 168px;
    padding: 24px 18px;
    transition: background-color 0.24s ease, padding-left 0.24s ease;
  }

  .lab-row:hover {
    background: color-mix(in srgb, var(--paper-card) 58%, transparent);
    padding-left: 28px;
  }

  .lab-index {
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 12px;
  }

  .lab-copy > span {
    color: var(--cyan);
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .lab-copy h3 {
    font-size: 23px;
    margin: 8px 0 7px;
  }

  .lab-copy p {
    color: var(--ink-soft);
    font-size: 13px;
    line-height: 1.65;
    margin: 0;
  }

  .lab-swatch {
    align-items: end;
    background: #eef7f7;
    border: 1px solid #c7dcdd;
    display: flex;
    gap: 16px;
    height: 92px;
    justify-content: center;
    padding: 17px;
  }

  .lab-swatch i {
    background: var(--cyan);
    height: 30%;
    width: 28px;
  }

  .lab-swatch i:nth-child(2) {
    height: 72%;
  }

  .lab-swatch i:nth-child(3) {
    height: 48%;
  }

  .lab-swatch.coral {
    background: #fbf0ea;
    border-color: #ecd2c3;
  }

  .lab-swatch.coral i {
    background: var(--coral);
  }

  .lab-swatch.ink {
    background: #172333;
    border-color: #2c4259;
  }

  .lab-swatch.ink i {
    background: #77baf1;
  }

  .lab-arrow {
    color: var(--blue);
    font-size: 19px;
  }

  .archive-list {
    display: grid;
  }

  .archive-row {
    align-items: center;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 28px;
    grid-template-columns: 42px minmax(250px, 0.9fr) minmax(0, 1.15fr) 94px 20px;
    min-height: 122px;
    padding: 20px 12px;
    transition: color 0.2s ease, padding-left 0.2s ease;
  }

  .archive-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .archive-row:hover {
    color: var(--blue);
    padding-left: 22px;
  }

  .archive-no,
  .archive-row time {
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 11px;
  }

  .archive-category {
    color: var(--coral);
    font-family: var(--sans);
    font-size: 11px;
  }

  .archive-row h3 {
    font-size: 19px;
    margin: 6px 0 0;
  }

  .archive-row p {
    color: var(--ink-soft);
    display: -webkit-box;
    font-size: 13px;
    line-height: 1.65;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .closing-section {
    align-items: center;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    padding-bottom: 112px;
    padding-top: 112px;
  }

  .closing-section p {
    font-family: var(--hand);
    font-size: clamp(28px, 3vw, 42px);
    margin: 0;
    transform: rotate(-0.7deg);
  }

  .closing-section a {
    background: var(--blue);
    border-radius: 5px;
    color: var(--on-blue);
    padding: 14px 22px;
  }

  .paper-footer {
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 12px;
  }

  .paper-footer .shell {
    align-items: center;
    display: flex;
    gap: 26px;
    justify-content: space-between;
    min-height: 90px;
  }

  .paper-footer nav {
    display: flex;
    gap: 20px;
  }

  .js [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.46s ease, transform 0.46s ease;
  }

  .js [data-reveal].visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 1120px) {
    .hero-copy h1 {
      font-size: clamp(40px, 4.6vw, 58px);
    }

    .direction-board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .direction-topic:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }

    .direction-topic:nth-child(odd) {
      border-left: 0;
    }

    .lab-row {
      grid-template-columns: 42px minmax(0, 1fr) 220px 20px;
    }
  }

  @media (max-width: 820px) {
    .shell {
      padding-left: 24px;
      padding-right: 24px;
    }

    .hero-copy h1 {
      font-size: clamp(38px, 8vw, 60px);
    }

    .series-grid {
      gap: 54px;
      grid-template-columns: 1fr;
    }

    .lab-row {
      grid-template-columns: 36px minmax(0, 1fr) 18px;
    }

    .lab-swatch {
      display: none;
    }

    .archive-row {
      align-items: start;
      gap: 12px 18px;
      grid-template-columns: 32px minmax(0, 1fr) 70px;
      padding: 20px 4px;
    }

    .archive-row p {
      grid-column: 2 / -1;
    }

    .archive-row > span:last-child {
      display: none;
    }

    .closing-section {
      align-items: flex-start;
      flex-direction: column;
      gap: 35px;

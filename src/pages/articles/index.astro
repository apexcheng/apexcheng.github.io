---
import { getCollection } from 'astro:content';
import ArticleList from '../../components/ArticleList.astro';
import ContentViewTabs from '../../components/ContentViewTabs.astro';
import RelatedSeries from '../../components/RelatedSeries.astro';
import { categoryMetaList } from '../../data/categories';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { withBase } from '../../utils/paths';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft && !post.data.private)
  .sort((a, b) => Number(b.data.pinned) - Number(a.data.pinned) || b.data.date.valueOf() - a.data.date.valueOf());
const activePosts = posts.filter((post) => !post.data.archived);
const officialPosts = posts.filter((post) => post.data.category !== '视觉实验室');
const activeOfficialPosts = officialPosts.filter((post) => !post.data.archived);
const standalonePosts = activePosts.filter((post) => !post.data.series);
const standaloneAllPosts = posts.filter((post) => !post.data.series);
const standaloneOfficialPosts = activeOfficialPosts.filter((post) => !post.data.series);
const standaloneAllOfficialPosts = officialPosts.filter((post) => !post.data.series);
const articlesPageUrl = withBase('/articles/');
const categoryCounts = Object.fromEntries(
  categoryMetaList.map((category) => [category.name, {
    standalone: standalonePosts.filter((post) => post.data.category === category.name).length,
    all: activePosts.filter((post) => post.data.category === category.name).length,
    standaloneArchived: standaloneAllPosts.filter((post) => post.data.category === category.name).length,
    allArchived: posts.filter((post) => post.data.category === category.name).length,
  }]),
);
const tags = Array.from(new Set(activeOfficialPosts.flatMap((post) => post.data.tags))).sort((a, b) => a.localeCompare(b));
const tagCounts = Object.fromEntries(tags.map((tag) => [tag, activeOfficialPosts.filter((post) => post.data.tags.includes(tag)).length]));
const commonTags = [...tags]
  .sort((a, b) => tagCounts[b] - tagCounts[a] || a.localeCompare(b))
  .slice(0, 10);
const otherTags = tags.filter((tag) => !commonTags.includes(tag));
---

<SiteLayout title="文章列表" active="articles">
  <main class="page-content two-column-page" data-articles-page>
    <header class="articles-page-intro">
      <h1 class="page-title">文章与系列</h1>
      <ContentViewTabs active="articles" />
    </header>
    <aside class="filter-panel" id="article-filters">
      <h2>内容分类</h2>
      <a class="active" href={articlesPageUrl} data-category-filter data-category-value="" aria-current="page">
        全部分类 <span data-count-all={activeOfficialPosts.length} data-count-standalone={standaloneOfficialPosts.length} data-count-all-archived={officialPosts.length} data-count-standalone-archived={standaloneAllOfficialPosts.length}>{standaloneOfficialPosts.length}</span>
      </a>
      {categoryMetaList.map((category) => (
        <a
          href={`${articlesPageUrl}?category=${encodeURIComponent(category.name)}`}
          data-category-filter
          data-category-value={category.name}
        >
          {category.name} <span data-count-all={categoryCounts[category.name].all} data-count-standalone={categoryCounts[category.name].standalone} data-count-all-archived={categoryCounts[category.name].allArchived} data-count-standalone-archived={categoryCounts[category.name].standaloneArchived}>{categoryCounts[category.name].standalone}</span>
        </a>
      ))}
      <h2 class="filter-subtitle">常用标签</h2>
      <div class="chips filter-tags" id="article-filter-tags">
        {commonTags.map((tag) => (
          <a href={withBase(`/articles/tag/${encodeURIComponent(tag)}/`)}>{tag}</a>
        ))}
        {otherTags.map((tag) => (
          <a href={withBase(`/articles/tag/${encodeURIComponent(tag)}/`)} data-extra-tag hidden>{tag}</a>
        ))}
      </div>
      {otherTags.length > 0 && (
        <button
          class="filter-tags-toggle"
          type="button"
          data-tags-toggle
          aria-controls="article-filter-tags"
          aria-expanded="false"
        >
          查看全部标签 <span aria-hidden="true">→</span>
        </button>
      )}
    </aside>
    <section class="articles-main-content">
      <div class="article-list-toolbar">
        <label class="article-inline-search">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10.8" cy="10.8" r="7"/><path d="m16 16 5 5"/></svg>
          <input type="search" data-articles-search placeholder="搜索标题、摘要或标签" aria-label="搜索文章标题、摘要或标签" autocomplete="off" />
        </label>
        <div class="article-toolbar-actions">
          <button class="article-toolbar-button article-featured-button" type="button" data-featured-only aria-pressed="false">
            <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="m12 2 3.1 6.4 7.1 1-5.1 5 .9 7.1-6-3.3-6 3.3.9-7.1-5.1-5 7.1-1z"/></svg>
            精选
          </button>
          <details class="article-more-filters" data-more-filters>
            <summary class="article-toolbar-button">
              <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M7 12h10M10 17h4"/></svg>
              筛选<span class="article-filter-indicator" data-filter-indicator hidden></span>
            </summary>
            <div class="article-filter-popover">
              <label class="article-filter-toggle">
                <input type="checkbox" data-include-archived />
                <span>包含已归档文章</span>
              </label>
              <p>默认不显示归档文章。</p>
            </div>
          </details>
          <details class="article-sort" data-sort-menu>
            <summary class="article-toolbar-button article-sort-trigger" aria-label="文章排序">
              <span data-sort-label>最新发布</span>
              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="article-sort-popover" aria-label="排序方式">
              <button type="button" data-sort-option data-sort-value="date" aria-pressed="true">最新发布 <span aria-hidden="true">✓</span></button>
              <button type="button" data-sort-option data-sort-value="updated" aria-pressed="false">最近更新 <span aria-hidden="true">✓</span></button>
            </div>
          </details>
        </div>
      </div>
      <div class="articles-results-meta">
        <p class="articles-results-summary" role="status" aria-live="polite" data-articles-summary>共 {standaloneOfficialPosts.length} 篇独立文章</p>
        <button type="button" class="article-filter-clear" data-clear-article-filters hidden>清除筛选</button>
      </div>
      <ArticleList posts={posts} hideSeries hideVisualLab showPinned inlineMeta />
      <p class="article-filter-empty" data-empty-state hidden>没有匹配的文章，请尝试其他关键词或分类。</p>
      <RelatedSeries posts={posts} heading="按完整学习路线阅读" />
    </section>
  </main>
  <script is:inline>
    (function () {
      var page = document.querySelector('[data-articles-page]');
      if (!page) return;

      var filters = Array.prototype.slice.call(page.querySelectorAll('[data-category-filter]'));
      var items = Array.prototype.slice.call(page.querySelectorAll('[data-article-item]'));
      var sortMenu = page.querySelector('[data-sort-menu]');
      var sortOptions = Array.prototype.slice.call(page.querySelectorAll('[data-sort-option]'));
      var sortLabel = page.querySelector('[data-sort-label]');
      var list = page.querySelector('[data-article-list]');
      var emptyState = page.querySelector('[data-empty-state]');
      var tagsToggle = page.querySelector('[data-tags-toggle]');
      var extraTags = Array.prototype.slice.call(page.querySelectorAll('[data-extra-tag]'));
      var tagPanel = page.querySelector('#article-filter-tags');
      var relatedSeriesLinks = Array.prototype.slice.call(page.querySelectorAll('[data-related-series-id]'));
      var relatedSeriesWrap = page.querySelector('[data-related-series]');
      var summary = page.querySelector('[data-articles-summary]');
      var searchInput = page.querySelector('[data-articles-search]');
      var featuredOnlyButton = page.querySelector('[data-featured-only]');
      var includeArchivedInput = page.querySelector('[data-include-archived]');
      var moreFilters = page.querySelector('[data-more-filters]');
      var filterIndicator = page.querySelector('[data-filter-indicator]');
      var clearFiltersButton = page.querySelector('[data-clear-article-filters]');
      var categoryCounts = Array.prototype.slice.call(page.querySelectorAll('[data-category-filter] span[data-count-all]'));
      var currentSort = 'date';
      // Keep existing ?series=1 links working, but guide new browsing through the series tab.
      var includeSeries = false;

      if (tagsToggle) {
        tagsToggle.addEventListener('click', function () {
          var isExpanded = tagsToggle.getAttribute('aria-expanded') === 'true';

          extraTags.forEach(function (tag) {
            tag.hidden = isExpanded;
          });
          if (tagPanel) tagPanel.classList.toggle('is-mobile-open', !isExpanded);

          tagsToggle.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
          tagsToggle.innerHTML = isExpanded
            ? '查看全部标签 <span aria-hidden="true">→</span>'
            : '收起标签 <span aria-hidden="true">↑</span>';
        });
      }

      function setActiveFilter(category) {
        var activeFilter = null;

        filters.forEach(function (filter) {
          var isActive = (filter.getAttribute('data-category-value') || '') === category;
          filter.classList.toggle('active', isActive);

          if (isActive) {
            filter.setAttribute('aria-current', 'page');
            activeFilter = filter;
            return;
          }

          filter.removeAttribute('aria-current');
        });

        return activeFilter;
      }

      function updateLastVisibleItem() {
        var lastVisibleItem = null;
        var orderedItems = list ? Array.prototype.slice.call(list.querySelectorAll('[data-article-item]')) : items;

        orderedItems.forEach(function (item) {
          item.classList.remove('is-filtered-last');
          if (!item.hidden) lastVisibleItem = item;
        });

        if (lastVisibleItem) lastVisibleItem.classList.add('is-filtered-last');
      }

      function applySort(sortValue) {
        if (!list) return;

        if (sortLabel) sortLabel.textContent = sortValue === 'updated' ? '最近更新' : '最新发布';
        sortOptions.forEach(function (option) {
          option.setAttribute('aria-pressed', option.getAttribute('data-sort-value') === sortValue ? 'true' : 'false');
        });
        items.forEach(function (item) {
          item.querySelectorAll('[data-date-kind]').forEach(function (time) {
            time.hidden = time.getAttribute('data-date-kind') !== sortValue;
          });
        });

        items
          .slice()
          .sort(function (a, b) {
            var pinnedDiff = Number(b.getAttribute('data-pinned') === 'true') - Number(a.getAttribute('data-pinned') === 'true');
            if (pinnedDiff) return pinnedDiff;

            var field = sortValue === 'updated' ? 'data-updated-at' : 'data-published-at';
            return Number(b.getAttribute(field) || 0) - Number(a.getAttribute(field) || 0);
          })
          .forEach(function (item) {
            list.appendChild(item);
          });

        updateLastVisibleItem();
      }

      function applyFilter(category, updateUrl) {
        var activeFilter = setActiveFilter(category);
        var visibleCount = 0;
        var query = searchInput ? searchInput.value.trim().toLocaleLowerCase() : '';
        var terms = query.split(/\s+/).filter(Boolean);
        var featuredOnly = featuredOnlyButton && featuredOnlyButton.getAttribute('aria-pressed') === 'true';
        var includeArchived = includeArchivedInput && includeArchivedInput.checked;

        items.forEach(function (item) {
          var itemCategory = item.getAttribute('data-category') || '';
          var searchable = item.getAttribute('data-search-text') || '';
          var isVisible = (includeSeries || !item.getAttribute('data-series')) &&
            (category === '视觉实验室' || itemCategory !== '视觉实验室') &&
            (!featuredOnly || item.getAttribute('data-featured') === 'true') &&
            (includeArchived || item.getAttribute('data-archived') !== 'true') &&
            (!category || itemCategory === category) &&
            terms.every(function (term) { return searchable.includes(term); });
          item.hidden = !isVisible;
          if (isVisible) visibleCount += 1;
        });

        categoryCounts.forEach(function (count) {
          var countKey = includeSeries ? 'data-count-all' : 'data-count-standalone';
          count.textContent = count.getAttribute(countKey + (includeArchived ? '-archived' : ''));
        });
        updateLastVisibleItem();

        if (list) list.hidden = visibleCount === 0;
        if (emptyState) emptyState.hidden = visibleCount !== 0;
        if (summary) summary.textContent = '共 ' + visibleCount + (includeSeries ? ' 篇文章 · 包含系列文章' : ' 篇独立文章') + (featuredOnly ? ' · 只看精选' : '') + (includeArchived ? ' · 包含已归档' : '') + (category ? ' · ' + category : '') + (query ? ' · “' + query + '”' : '');
        if (filterIndicator) filterIndicator.hidden = !includeArchived;
        if (clearFiltersButton) clearFiltersButton.hidden = !includeSeries && !featuredOnly && !includeArchived && !category && !query;
        if (relatedSeriesWrap) {
          var shownSeries = 0;
          relatedSeriesLinks.forEach(function (link) {
            var seriesId = link.getAttribute('data-related-series-id');
            var available = items.some(function (item) {
              return !item.hidden && item.getAttribute('data-series') === seriesId;
            });
            link.hidden = !available;
            if (available) shownSeries += 1;
          });
          relatedSeriesWrap.hidden = shownSeries === 0;
        }

        if (updateUrl && activeFilter) {
          var url = new URL(window.location.href);
          if (category) url.searchParams.set('category', category);
          else url.searchParams.delete('category');
          if (query) url.searchParams.set('q', query);
          else url.searchParams.delete('q');
          if (includeSeries) url.searchParams.set('series', '1');
          else url.searchParams.delete('series');
          if (featuredOnly) url.searchParams.set('featured', '1');
          else url.searchParams.delete('featured');
          if (includeArchived) url.searchParams.set('archived', '1');
          else url.searchParams.delete('archived');
          history.replaceState(null, '', url.pathname + url.search);
        }

        applySort(currentSort);
      }

      filters.forEach(function (filter) {
        filter.addEventListener('click', function (event) {
          event.preventDefault();
          applyFilter(filter.getAttribute('data-category-value') || '', true);
        });
      });

      sortOptions.forEach(function (option) {
        option.addEventListener('click', function () {
          currentSort = option.getAttribute('data-sort-value') || 'date';
          applySort(currentSort);
          sortMenu.open = false;
          sortMenu.querySelector('summary').focus();
        });
      });
      if (sortMenu) {
        var sortTrigger = sortMenu.querySelector('summary');
        document.addEventListener('click', function (event) {
          if (!sortMenu.contains(event.target)) sortMenu.open = false;
        });
        sortMenu.addEventListener('keydown', function (event) {
          if (event.key === 'Escape' && sortMenu.open) {
            sortMenu.open = false;
            sortTrigger.focus();
          } else if ((event.key === 'ArrowDown' || event.key === 'ArrowUp') && (event.target === sortTrigger || sortOptions.includes(event.target))) {
            event.preventDefault();
            if (!sortMenu.open) sortMenu.open = true;
            var index = sortOptions.indexOf(event.target);
            if (index === -1) index = sortOptions.findIndex(function (option) { return option.getAttribute('aria-pressed') === 'true'; });
            var next = (index + (event.key === 'ArrowDown' ? 1 : -1) + sortOptions.length) % sortOptions.length;
            sortOptions[next].focus();
          }
        });
      }

      if (searchInput) {
        searchInput.addEventListener('input', function () {
          var category = (filters.find(function (filter) { return filter.classList.contains('active'); }) || filters[0]).getAttribute('data-category-value') || '';
          applyFilter(category, true);
        });
      }
      if (featuredOnlyButton) {
        featuredOnlyButton.addEventListener('click', function () {
          featuredOnlyButton.setAttribute('aria-pressed', featuredOnlyButton.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
          var category = (filters.find(function (filter) { return filter.classList.contains('active'); }) || filters[0]).getAttribute('data-category-value') || '';
          applyFilter(category, true);
        });
      }
      if (includeArchivedInput) {
        includeArchivedInput.addEventListener('change', function () {
          var category = (filters.find(function (filter) { return filter.classList.contains('active'); }) || filters[0]).getAttribute('data-category-value') || '';
          applyFilter(category, true);
        });
      }
      if (clearFiltersButton) {
        clearFiltersButton.addEventListener('click', function () {
          includeSeries = false;
          if (searchInput) searchInput.value = '';
          if (featuredOnlyButton) featuredOnlyButton.setAttribute('aria-pressed', 'false');
          if (includeArchivedInput) includeArchivedInput.checked = false;
          if (moreFilters) moreFilters.open = false;
          applyFilter('', true);
        });
      }
      if (moreFilters) {
        document.addEventListener('click', function (event) {
          if (!moreFilters.contains(event.target)) moreFilters.open = false;
        });
        moreFilters.addEventListener('keydown', function (event) {
          if (event.key === 'Escape') {
            moreFilters.open = false;
            moreFilters.querySelector('summary').focus();
          }
        });
      }

      var initialCategory = '';

      try {
        var requestedCategory = new URLSearchParams(window.location.search).get('category') || '';
        if (searchInput) searchInput.value = new URLSearchParams(window.location.search).get('q') || '';
        includeSeries = new URLSearchParams(window.location.search).get('series') === '1';
        if (featuredOnlyButton) featuredOnlyButton.setAttribute('aria-pressed', new URLSearchParams(window.location.search).get('featured') === '1' ? 'true' : 'false');
        if (includeArchivedInput) includeArchivedInput.checked = new URLSearchParams(window.location.search).get('archived') === '1';
        var matchedFilter = filters.some(function (filter) {
          return (filter.getAttribute('data-category-value') || '') === requestedCategory;
        });
        if (matchedFilter) initialCategory = requestedCategory;
      } catch (error) {}

      applyFilter(initialCategory, false);
    })();
  </script>
</SiteLayout>

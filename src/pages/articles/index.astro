---
import { getCollection } from 'astro:content';
import ArticleList from '../../components/ArticleList.astro';
import ContentViewTabs from '../../components/ContentViewTabs.astro';
import RelatedSeries from '../../components/RelatedSeries.astro';
import { categoryMetaList } from '../../data/categories';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { withBase } from '../../utils/paths';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft && !post.data.private)
  .sort((a, b) => Number(b.data.pinned) - Number(a.data.pinned) || b.data.date.valueOf() - a.data.date.valueOf());
const standalonePosts = posts.filter((post) => !post.data.series);
const articlesPageUrl = withBase('/articles/');
const categoryCounts = Object.fromEntries(
  categoryMetaList.map((category) => [category.name, standalonePosts.filter((post) => post.data.category === category.name).length]),
);
const tags = Array.from(new Set(posts.flatMap((post) => post.data.tags))).sort((a, b) => a.localeCompare(b));
const tagCounts = Object.fromEntries(tags.map((tag) => [tag, posts.filter((post) => post.data.tags.includes(tag)).length]));
const commonTags = [...tags]
  .sort((a, b) => tagCounts[b] - tagCounts[a] || a.localeCompare(b))
  .slice(0, 15);
const otherTags = tags.filter((tag) => !commonTags.includes(tag));
---

<SiteLayout title="文章列表" active="articles">
  <main class="page-content two-column-page" data-articles-page>
    <header class="articles-page-intro">
      <p class="eyebrow">内容索引</p>
      <h1 class="page-title">文章与系列</h1>
      <ContentViewTabs active="articles" />
    </header>
    <aside class="filter-panel" id="article-filters">
      <h2>内容分类</h2>
      <a class="active" href={articlesPageUrl} data-category-filter data-category-value="" aria-current="page">
        全部文章 <span data-count-all={posts.length} data-count-standalone={standalonePosts.length}>{standalonePosts.length}</span>
      </a>
      {categoryMetaList.map((category) => (
        <a
          href={`${articlesPageUrl}?category=${encodeURIComponent(category.name)}`}
          data-category-filter
          data-category-value={category.name}
        >
          {category.name} <span data-count-all={posts.filter((post) => post.data.category === category.name).length} data-count-standalone={categoryCounts[category.name]}>{categoryCounts[category.name]}</span>
        </a>
      ))}
      <h2 class="filter-subtitle">常用标签</h2>
      <div class="chips filter-tags" id="article-filter-tags">
        {commonTags.map((tag) => (
          <a href={withBase(`/articles/tag/${encodeURIComponent(tag)}/`)}>{tag}</a>
        ))}
        {otherTags.map((tag) => (
          <a href={withBase(`/articles/tag/${encodeURIComponent(tag)}/`)} data-extra-tag hidden>{tag}</a>
        ))}
      </div>
      {otherTags.length > 0 && (
        <button
          class="filter-tags-toggle"
          type="button"
          data-tags-toggle
          aria-controls="article-filter-tags"
          aria-expanded="false"
        >
          查看全部标签 <span aria-hidden="true">→</span>
        </button>
      )}
    </aside>
    <section class="articles-main-content">
      <div class="article-list-toolbar">
        <label class="article-inline-search">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10.8" cy="10.8" r="7"/><path d="m16 16 5 5"/></svg>
          <input type="search" data-articles-search placeholder="搜索标题、摘要或标签" aria-label="搜索文章标题、摘要或标签" autocomplete="off" />
        </label>
        <label class="article-series-toggle">
          <input type="checkbox" data-include-series />
          <span>包含系列文章</span>
        </label>
        <div class="article-sort" aria-label="文章排序">
          <span>排序</span>
          <button class="active" type="button" data-sort-option data-sort-value="date" aria-pressed="true">发布时间</button>
          <button type="button" data-sort-option data-sort-value="updated" aria-pressed="false">修改时间</button>
        </div>
      </div>
      <p class="articles-results-summary" role="status" aria-live="polite" data-articles-summary>共 {standalonePosts.length} 篇文章</p>
      <ArticleList posts={posts} hideSeries showPinned />
      <p class="article-filter-empty" data-empty-state hidden>没有匹配的文章，请尝试其他关键词或分类。</p>
      <RelatedSeries posts={posts} heading="按完整学习路线阅读" />
    </section>
  </main>
  <script is:inline>
    (function () {
      var page = document.querySelector('[data-articles-page]');
      if (!page) return;

      var filters = Array.prototype.slice.call(page.querySelectorAll('[data-category-filter]'));
      var items = Array.prototype.slice.call(page.querySelectorAll('[data-article-item]'));
      var sortOptions = Array.prototype.slice.call(page.querySelectorAll('[data-sort-option]'));
      var list = page.querySelector('[data-article-list]');
      var emptyState = page.querySelector('[data-empty-state]');
      var tagsToggle = page.querySelector('[data-tags-toggle]');
      var extraTags = Array.prototype.slice.call(page.querySelectorAll('[data-extra-tag]'));
      var tagPanel = page.querySelector('#article-filter-tags');
      var relatedSeriesLinks = Array.prototype.slice.call(page.querySelectorAll('[data-related-series-id]'));
      var relatedSeriesWrap = page.querySelector('[data-related-series]');
      var summary = page.querySelector('[data-articles-summary]');
      var searchInput = page.querySelector('[data-articles-search]');
      var includeSeriesInput = page.querySelector('[data-include-series]');
      var categoryCounts = Array.prototype.slice.call(page.querySelectorAll('[data-category-filter] span[data-count-all]'));
      var currentSort = 'date';

      if (tagsToggle) {
        tagsToggle.addEventListener('click', function () {
          var isExpanded = tagsToggle.getAttribute('aria-expanded') === 'true';

          extraTags.forEach(function (tag) {
            tag.hidden = isExpanded;
          });
          if (tagPanel) tagPanel.classList.toggle('is-mobile-open', !isExpanded);

          tagsToggle.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
          tagsToggle.innerHTML = isExpanded
            ? '查看全部标签 <span aria-hidden="true">→</span>'
            : '收起标签 <span aria-hidden="true">↑</span>';
        });
      }

      function setActiveFilter(category) {
        var activeFilter = null;

        filters.forEach(function (filter) {
          var isActive = (filter.getAttribute('data-category-value') || '') === category;
          filter.classList.toggle('active', isActive);

          if (isActive) {
            filter.setAttribute('aria-current', 'page');
            activeFilter = filter;
            return;
          }

          filter.removeAttribute('aria-current');
        });

        return activeFilter;
      }

      function updateLastVisibleItem() {
        var lastVisibleItem = null;
        var orderedItems = list ? Array.prototype.slice.call(list.querySelectorAll('[data-article-item]')) : items;

        orderedItems.forEach(function (item) {
          item.classList.remove('is-filtered-last');
          if (!item.hidden) lastVisibleItem = item;
        });

        if (lastVisibleItem) lastVisibleItem.classList.add('is-filtered-last');
      }

      function setActiveSort(sortValue) {
        sortOptions.forEach(function (sortOption) {
          var isActive = sortOption.getAttribute('data-sort-value') === sortValue;
          sortOption.classList.toggle('active', isActive);
          sortOption.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
      }

      function applySort(sortValue) {
        if (!list) return;

        setActiveSort(sortValue);
        items.forEach(function (item) {
          item.querySelectorAll('[data-date-kind]').forEach(function (time) {
            time.hidden = time.getAttribute('data-date-kind') !== sortValue;
          });
        });

        items
          .slice()
          .sort(function (a, b) {
            var pinnedDiff = Number(b.getAttribute('data-pinned') === 'true') - Number(a.getAttribute('data-pinned') === 'true');
            if (pinnedDiff) return pinnedDiff;

            var field = sortValue === 'updated' ? 'data-updated-at' : 'data-published-at';
            return Number(b.getAttribute(field) || 0) - Number(a.getAttribute(field) || 0);
          })
          .forEach(function (item) {
            list.appendChild(item);
          });

        updateLastVisibleItem();
      }

      function applyFilter(category, updateUrl) {
        var activeFilter = setActiveFilter(category);
        var visibleCount = 0;
        var query = searchInput ? searchInput.value.trim().toLocaleLowerCase() : '';
        var terms = query.split(/\s+/).filter(Boolean);
        var includeSeries = includeSeriesInput && includeSeriesInput.checked;

        items.forEach(function (item) {
          var itemCategory = item.getAttribute('data-category') || '';
          var searchable = item.getAttribute('data-search-text') || '';
          var isVisible = (includeSeries || !item.getAttribute('data-series')) &&
            (!category || itemCategory === category) &&
            terms.every(function (term) { return searchable.includes(term); });
          item.hidden = !isVisible;
          if (isVisible) visibleCount += 1;
        });

        categoryCounts.forEach(function (count) {
          count.textContent = count.getAttribute(includeSeries ? 'data-count-all' : 'data-count-standalone');
        });
        updateLastVisibleItem();

        if (list) list.hidden = visibleCount === 0;
        if (emptyState) emptyState.hidden = visibleCount !== 0;
        if (summary) summary.textContent = '找到 ' + visibleCount + ' 篇文章' + (category ? ' · ' + category : '') + (query ? ' · “' + query + '”' : '');
        if (relatedSeriesWrap) {
          var shownSeries = 0;
          relatedSeriesLinks.forEach(function (link) {
            var seriesId = link.getAttribute('data-related-series-id');
            var available = items.some(function (item) {
              return !item.hidden && item.getAttribute('data-series') === seriesId;
            });
            link.hidden = !available;
            if (available) shownSeries += 1;
          });
          relatedSeriesWrap.hidden = shownSeries === 0;
        }

        if (updateUrl && activeFilter) {
          var url = new URL(window.location.href);
          if (category) url.searchParams.set('category', category);
          else url.searchParams.delete('category');
          if (query) url.searchParams.set('q', query);
          else url.searchParams.delete('q');
          if (includeSeries) url.searchParams.set('series', '1');
          else url.searchParams.delete('series');
          history.replaceState(null, '', url.pathname + url.search);
        }

        applySort(currentSort);
      }

      filters.forEach(function (filter) {
        filter.addEventListener('click', function (event) {
          event.preventDefault();
          applyFilter(filter.getAttribute('data-category-value') || '', true);
        });
      });

      sortOptions.forEach(function (sortOption) {
        sortOption.addEventListener('click', function () {
          currentSort = sortOption.getAttribute('data-sort-value') || 'date';
          applySort(currentSort);
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', function () {
          var category = (filters.find(function (filter) { return filter.classList.contains('active'); }) || filters[0]).getAttribute('data-category-value') || '';
          applyFilter(category, true);
        });
      }
      if (includeSeriesInput) {
        includeSeriesInput.addEventListener('change', function () {
          var category = (filters.find(function (filter) { return filter.classList.contains('active'); }) || filters[0]).getAttribute('data-category-value') || '';
          applyFilter(category, true);
        });
      }

      var initialCategory = '';

      try {
        var requestedCategory = new URLSearchParams(window.location.search).get('category') || '';
        if (searchInput) searchInput.value = new URLSearchParams(window.location.search).get('q') || '';
        if (includeSeriesInput) includeSeriesInput.checked = new URLSearchParams(window.location.search).get('series') === '1';
        var matchedFilter = filters.some(function (filter) {
          return (filter.getAttribute('data-category-value') || '') === requestedCategory;
        });
        if (matchedFilter) initialCategory = requestedCategory;
      } catch (error) {}

      applyFilter(initialCategory, false);
    })();
  </script>
</SiteLayout>

---
import { ClipboardCopy, Search } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { orderedPromptEntries, promptCategories } from '../data/prompts';
const categoryCounts = promptCategories.map((category) => ({
  category,
  count: orderedPromptEntries.filter((entry) => entry.category === category).length,
}));
---

<SiteLayout title="提示词库" active="prompts" description="常用 AI 提示词集中整理，查看完整内容，一键复制使用。">
  <main class="prompt-library page-content">
    <header class="prompt-intro">
      <p class="prompt-eyebrow">PROMPT LIBRARY / 可复用的工作方法</p>
      <h1>提示词库<span class="prompt-count">{String(orderedPromptEntries.length).padStart(2, '0')}</span></h1>
      <p>把反复使用的指令整理成可直接执行的文本。找到需要的提示词，一键复制即可使用。</p>
    </header>

    <div class="prompt-layout">
      <aside class="prompt-discovery" aria-label="寻找提示词">
        <div class="prompt-search-field">
          <Search size={18} aria-hidden="true" />
          <input id="prompt-search" type="search" aria-label="搜索提示词" placeholder="搜索提示词标题、用途或案例" autocomplete="off" data-prompt-search />
        </div>
        <div class="prompt-filter-row">
          <div class="prompt-category-buttons" role="group" aria-label="提示词分类">
            <button type="button" data-prompt-category="all" aria-pressed="true">全部 <span>{orderedPromptEntries.length}</span></button>
            {categoryCounts.map(({ category, count }) => (
              <button type="button" data-prompt-category={category} aria-pressed="false">{category} <span>{count}</span></button>
            ))}
          </div>
          <span data-visible-prompt-count>{orderedPromptEntries.length} 条结果</span>
        </div>
        <nav class="prompt-index" aria-label="提示词搜索结果">
          <ol class="prompt-index-links">
            {orderedPromptEntries.map((entry) => (
              <li data-prompt-index-item data-category={entry.category} data-prompt-id={entry.id}
                  data-search-text={`${entry.title} ${entry.description} ${entry.usedCase}`}>
                <a href={`#${entry.id}`} data-prompt-index-link title={entry.title}>
                  <span class="prompt-index-title">{entry.title}</span>
                  <span class="prompt-index-meta">{entry.pinned ? '置顶' : entry.category}</span>
                </a>
              </li>
            ))}
          </ol>
          <p class="prompt-no-results" data-no-results hidden>没有符合条件的提示词，请调整关键词或分类。</p>
        </nav>
      </aside>

      <section class="prompt-detail" aria-label="当前提示词详情">
        {orderedPromptEntries.map((entry, index) => (
          <article class="prompt-entry" id={entry.id} data-category={entry.category} data-prompt-entry hidden={index !== 0}>
            <div class="prompt-detail-topline">
              <span>{entry.category}</span>
              {entry.pinned && <span class="prompt-pin-tag">置顶</span>}
            </div>
            <h2 tabindex="-1">{entry.title}</h2>
            <p class="prompt-description">{entry.description}</p>
            <div class="prompt-used-case">
              <strong>已使用案例</strong>
              <p>{entry.usedCase}</p>
            </div>
            <div class="prompt-content-heading">
              <h3>完整提示词</h3>
              <button class="prompt-copy" type="button" data-copy-prompt aria-label={`复制提示词：${entry.title}`}>
                <ClipboardCopy size={16} aria-hidden="true" /><span data-copy-label>复制完整提示词</span>
              </button>
            </div>
            <p class="prompt-copy-feedback" role="status" aria-live="polite" data-copy-status></p>
            <pre class="prompt-content" data-prompt-content>{entry.content}</pre>
          </article>
        ))}
        <div class="prompt-detail-empty" data-detail-empty hidden>没有匹配的提示词。请调整左侧搜索或分类。</div>
      </section>
    </div>
  </main>
</SiteLayout>

<script>
  const entries = Array.from(document.querySelectorAll<HTMLElement>('[data-prompt-entry]'));
  const resultItems = Array.from(document.querySelectorAll<HTMLElement>('[data-prompt-index-item]'));
  const categoryButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-prompt-category]'));
  const search = document.querySelector<HTMLInputElement>('[data-prompt-search]');
  const resultCount = document.querySelector<HTMLElement>('[data-visible-prompt-count]');
  const emptyResults = document.querySelector<HTMLElement>('[data-no-results]');
  const emptyDetail = document.querySelector<HTMLElement>('[data-detail-empty]');
  const detail = document.querySelector<HTMLElement>('.prompt-detail');
  const validCategories = categoryButtons.map((button) => button.dataset.promptCategory ?? '');
  let category = 'all';
  let selectedId = entries[0]?.id ?? '';

  function selectCategory(value: string) {
    category = validCategories.includes(value) ? value : 'all';
  }

  function render() {
    const words = (search?.value.trim().toLocaleLowerCase() ?? '').split(/\s+/).filter(Boolean);
    const visible = resultItems.filter((item) => {
      const inCategory = category === 'all' || item.dataset.category === category;
      const text = item.dataset.searchText?.toLocaleLowerCase() ?? '';
      const match = inCategory && words.every((word) => text.includes(word));
      item.hidden = !match;
      return match;
    });
    const visibleIds = new Set(visible.map((item) => item.dataset.promptId));
    if (!visibleIds.has(selectedId)) selectedId = visible[0]?.dataset.promptId ?? '';

    entries.forEach((entry) => { entry.hidden = entry.id !== selectedId; });
    resultItems.forEach((item) => {
      const link = item.querySelector<HTMLAnchorElement>('[data-prompt-index-link]');
      if (!link) return;
      if (item.dataset.promptId === selectedId && !item.hidden) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
    categoryButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.promptCategory === category));
    });
    if (resultCount) resultCount.textContent = `${visible.length} 条结果`;
    if (emptyResults) emptyResults.hidden = visible.length > 0;
    if (emptyDetail) emptyDetail.hidden = visible.length > 0;
  }

  function updateUrl(mode: 'pushState' | 'replaceState') {
    const url = new URL(window.location.href);
    if (category === 'all') url.searchParams.delete('category');
    else url.searchParams.set('category', category);
    url.hash = selectedId;
    window.history[mode](null, '', url);
  }

  function showDetail() {
    detail?.scrollIntoView({ block: 'start' });
  }

  function restoreFromUrl() {
    const id = decodeURIComponent(window.location.hash.slice(1));
    const target = entries.find((entry) => entry.id === id);
    const requestedCategory = new URLSearchParams(window.location.search).get('category') ?? 'all';
    selectCategory(target?.dataset.category ?? requestedCategory);
    selectedId = target?.id ?? '';
    if (search) search.value = '';
    render();
    if (target) requestAnimationFrame(showDetail);
  }

  categoryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      selectCategory(button.dataset.promptCategory ?? 'all');
      render();
      updateUrl('replaceState');
      showDetail();
    });
  });

  search?.addEventListener('input', () => {
    const previousId = selectedId;
    render();
    updateUrl('replaceState');
    if (previousId !== selectedId) showDetail();
  });

  resultItems.forEach((item) => {
    item.querySelector<HTMLAnchorElement>('[data-prompt-index-link]')?.addEventListener('click', (event) => {
      event.preventDefault();
      selectedId = item.dataset.promptId ?? '';
      render();
      updateUrl('pushState');
      showDetail();
    });
  });

  window.addEventListener('popstate', restoreFromUrl);
  window.addEventListener('hashchange', restoreFromUrl);
  restoreFromUrl();

  document.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]').forEach((button) => {
    button.addEventListener('click', async () => {
      const entry = button.closest('.prompt-entry');
      const content = entry?.querySelector('[data-prompt-content]')?.textContent;
      const label = button.querySelector('[data-copy-label]');
      const status = entry?.querySelector('[data-copy-status]');
      if (!content || !label || !status) return;
      try {
        await navigator.clipboard.writeText(content);
        label.textContent = '已复制';
        status.textContent = '完整提示词已复制到剪贴板';
        button.classList.add('copied');
      } catch {
        label.textContent = '复制失败';
        status.textContent = '无法访问剪贴板，请从正文中手动复制';
      }
      window.setTimeout(() => {
        label.textContent = '复制完整提示词';
        button.classList.remove('copied');
        status.textContent = '';
      }, 2200);
    });
  });
</script>

<style>
  .prompt-library { max-width: 1250px; padding-top: 26px; padding-bottom: 80px; }
  .prompt-intro { margin-bottom: 26px; }
  .prompt-eyebrow { margin: 0 0 8px; color: var(--blue); font-size: 10px; font-weight: 650; letter-spacing: .12em; }
  .prompt-intro h1 { display: flex; align-items: start; gap: 12px; margin: 0; font-size: clamp(34px, 4vw, 44px); font-weight: 600; line-height: 1.18; letter-spacing: -.04em; }
  .prompt-count { margin-top: 5px; color: var(--muted); font: 12px var(--mono-font); letter-spacing: 0; }
  .prompt-intro > p:last-child { max-width: 650px; margin: 8px 0 0; font-size: 13px; line-height: 1.6; }
  .prompt-layout { display: grid; grid-template-columns: minmax(300px, 360px) minmax(0, 1fr); gap: 32px; align-items: start; }
  .prompt-discovery { position: sticky; top: 90px; display: flex; flex-direction: column; min-width: 0; max-height: calc(100dvh - 110px); padding: 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--paper); }
  .prompt-search-field { display: flex; align-items: center; gap: 8px; min-height: 38px; padding: 0 11px; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--muted); }
  .prompt-search-field:focus-within { border-color: var(--blue); outline: 2px solid color-mix(in srgb, var(--blue) 20%, transparent); }
  .prompt-search-field input { width: 100%; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--ink); font: 13px var(--body-font); }
  .prompt-search-field input::placeholder { color: var(--muted); }
  .prompt-filter-row { display: flex; flex-direction: column; gap: 6px; padding: 10px 0 8px; border-bottom: 1px solid var(--line); }
  .prompt-category-buttons { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 5px; }
  .prompt-category-buttons button { display: flex; align-items: center; justify-content: space-between; gap: 6px; min-height: 30px; padding: 4px 9px; border: 1px solid var(--line); border-radius: 5px; background: var(--bg); color: var(--ink); font: 12px var(--body-font); cursor: pointer; text-align: left; }
  .prompt-category-buttons button span { color: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; }
  .prompt-category-buttons button:hover { border-color: var(--blue); }
  .prompt-category-buttons button[aria-pressed='true'] { border-color: var(--blue); background: color-mix(in srgb, var(--blue) 9%, var(--paper)); color: var(--blue); font-weight: 650; }
  .prompt-category-buttons button[aria-pressed='true'] span { color: inherit; }
  .prompt-category-buttons button:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .prompt-filter-row > span { align-self: flex-end; color: var(--muted); font-size: 11px; white-space: nowrap; }
  .prompt-index { min-height: 90px; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--blue) 40%, transparent) transparent; }
  .prompt-index-links { list-style: none; margin: 0; padding: 0; }
  .prompt-index-links a { display: flex; align-items: center; gap: 8px; min-height: 40px; padding: 6px 9px; border-left: 2px solid transparent; border-bottom: 1px solid var(--line); border-radius: 3px; color: var(--ink); text-decoration: none; transition: background .15s, border-color .15s; }
  .prompt-index-links a:hover { background: var(--bg); }
  .prompt-index-links a[aria-current='true'] { border-left-color: var(--blue); background: var(--bg); }
  .prompt-index-title { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 13px; font-weight: 500; line-height: 1.5; }
  .prompt-index-links a[aria-current='true'] .prompt-index-title { font-weight: 650; }
  .prompt-index-meta { flex: none; color: var(--soft); font-size: 10px; }
  .prompt-no-results { color: var(--muted); font-size: 13px; line-height: 1.8; }
  .prompt-detail { min-width: 0; padding-top: 4px; scroll-margin-top: 100px; }
  .prompt-entry { scroll-margin-top: 100px; }
  .prompt-detail-topline { display: flex; gap: 12px; align-items: center; color: var(--muted); font-size: 12px; }
  .prompt-pin-tag { color: var(--blue); font-weight: 650; }
  .prompt-entry h2 { margin: 10px 0 14px; font-size: clamp(26px, 2.6vw, 32px); font-weight: 650; line-height: 1.38; letter-spacing: -.02em; }
  .prompt-entry h2:focus { outline: none; }
  .prompt-description { max-width: 730px; margin: 0; color: var(--muted); font-size: 15px; line-height: 1.8; }
  .prompt-used-case { margin: 22px 0 30px; padding: 14px 18px; border-left: 2px solid var(--blue); border-radius: 0 6px 6px 0; background: var(--paper); }
  .prompt-used-case strong { color: var(--blue); font-size: 12px; font-weight: 650; }
  .prompt-used-case p { margin: 6px 0 0; color: var(--muted); font-size: 13px; line-height: 1.7; }
  .prompt-content-heading { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .prompt-content-heading h3 { margin: 0; font-size: 16px; font-weight: 650; }
  .prompt-copy { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 40px; padding: 0 16px; border: 1px solid var(--blue); border-radius: 6px; background: var(--blue); color: var(--bg); font: 600 13px var(--body-font); cursor: pointer; transition: filter .15s; }
  .prompt-copy:hover { filter: brightness(.9); }
  .prompt-copy.copied { filter: brightness(.9); }
  .prompt-content { display: block; margin: 0; padding: 24px; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); color: var(--ink); white-space: pre-wrap; overflow-wrap: anywhere; font: 14px/1.9 var(--body-font); tab-size: 2; }
  .prompt-copy-feedback { margin: -4px 0 10px; color: var(--blue); font-size: 12px; }
  .prompt-copy-feedback:empty { display: none; }
  .prompt-detail-empty { margin-top: 20px; padding: 24px; border: 1px dashed var(--line); border-radius: 8px; color: var(--muted); font-size: 14px; }
  .prompt-entry[hidden], .prompt-index-links li[hidden], .prompt-no-results[hidden], .prompt-detail-empty[hidden] { display: none !important; }
  .prompt-index-links a:focus-visible, .prompt-copy:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  @media (max-width: 850px) {
    .prompt-layout { display: block; }
    .prompt-discovery { position: static; max-height: none; }
    .prompt-index { max-height: 300px; }
    .prompt-detail { margin-top: 32px; }
  }
  @media (max-width: 650px) {
    .prompt-library { padding-top: 20px; padding-bottom: 60px; }
    .prompt-intro { margin-bottom: 20px; }
    .prompt-discovery { padding: 12px; }
    .prompt-entry h2 { font-size: 25px; }
    .prompt-content { padding: 16px; font-size: 14px; }
    .prompt-content-heading { align-items: flex-start; flex-direction: column; }
    .prompt-copy { width: 100%; }
  }
</style>

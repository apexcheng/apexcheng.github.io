---
import { ClipboardCopy, ChevronDown } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { promptEntries } from '../data/prompts';
---

<SiteLayout title="提示词库" active="prompts" description="常用 AI 提示词集中整理，查看完整内容，一键复制使用。">
  <main class="prompt-library page-content">
    <header class="prompt-intro">
      <p class="prompt-eyebrow">PROMPT LIBRARY / 可复用的工作方法</p>
      <h1>提示词库<span class="prompt-count">{String(promptEntries.length).padStart(2, '0')}</span></h1>
      <p>把反复使用的指令整理成可直接执行的文本。找到需要的提示词，一键复制即可使用。</p>
    </header>

    <div class="prompt-layout">
      <aside class="prompt-index" aria-label="提示词目录">
        <nav class="prompt-index-desktop" aria-label="提示词目录">
          <p class="prompt-index-heading">目录 <span>{promptEntries.length} 条</span></p>
          <ol class="prompt-index-links">
            {promptEntries.map((entry, index) => (
              <li>
                <a href={`#${entry.id}`} data-prompt-index-link>
                  <span class="prompt-index-number">{String(index + 1).padStart(2, '0')}</span>
                  <span>{entry.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
        <details class="prompt-index-mobile">
          <summary>提示词目录 <span>{promptEntries.length} 条</span> <ChevronDown size={16} aria-hidden="true" /></summary>
          <nav aria-label="提示词目录">
            <ol class="prompt-index-links">
              {promptEntries.map((entry, index) => (
                <li>
                  <a href={`#${entry.id}`} data-prompt-index-link>
                    <span class="prompt-index-number">{String(index + 1).padStart(2, '0')}</span>
                    <span>{entry.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      </aside>

    <section class="prompt-list" aria-label="全部提示词">
      {promptEntries.map((entry, index) => (
        <article class="prompt-entry" id={entry.id}>
          <div class="prompt-entry-heading">
            <div class="prompt-heading-copy">
              <p class="prompt-entry-meta"><span>{entry.category}</span><span>NO. {String(index + 1).padStart(2, '0')}</span></p>
              <h2>{entry.title}</h2>
              <p>{entry.description}</p>
            </div>
            <button class="prompt-copy" type="button" data-copy-prompt aria-label={`复制提示词：${entry.title}`}>
              <ClipboardCopy size={17} aria-hidden="true" /><span data-copy-label>复制提示词</span>
            </button>
          </div>
          <details class="prompt-details">
            <summary>查看完整提示词 <ChevronDown size={16} aria-hidden="true" /></summary>
            <pre class="prompt-content" data-prompt-content>{entry.content}</pre>
          </details>
          <p class="prompt-copy-feedback" role="status" aria-live="polite" data-copy-status></p>
        </article>
      ))}
    </section>
    </div>
  </main>
</SiteLayout>

<script>
  const promptSections = Array.from(document.querySelectorAll<HTMLElement>('.prompt-entry'));
  const indexLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-prompt-index-link]'));
  const desktopIndex = document.querySelector<HTMLElement>('.prompt-index-desktop');
  let indexUpdateScheduled = false;

  function updateIndexOverflow() {
    const sidebar = desktopIndex?.closest('.prompt-index');
    if (!desktopIndex || !sidebar) return;
    sidebar.toggleAttribute('data-has-more', desktopIndex.scrollTop + desktopIndex.clientHeight < desktopIndex.scrollHeight - 6);
  }

  function highlightPrompt(id: string) {
    let activeDesktopLink: HTMLAnchorElement | undefined;
    indexLinks.forEach((link) => {
      if (link.hash === `#${id}`) {
        link.setAttribute('aria-current', 'location');
        if (desktopIndex?.contains(link)) activeDesktopLink = link;
      } else link.removeAttribute('aria-current');
    });
    if (!desktopIndex || !activeDesktopLink) return;
    const viewport = desktopIndex.getBoundingClientRect();
    const item = activeDesktopLink.getBoundingClientRect();
    if (item.bottom > viewport.bottom - 36) {
      desktopIndex.scrollTop += item.bottom - viewport.bottom + 48;
    } else if (item.top < viewport.top + 28) {
      desktopIndex.scrollTop += item.top - viewport.top - 36;
    }
    updateIndexOverflow();
  }

  function updateCurrentPrompt() {
    indexUpdateScheduled = false;
    const atPageEnd = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 12;
    const activationLine = Math.min(340, Math.max(170, window.innerHeight * 0.36));
    const current = atPageEnd
      ? promptSections[promptSections.length - 1]
      : [...promptSections].reverse().find((section) => section.getBoundingClientRect().top <= activationLine) ?? promptSections[0];
    if (current) highlightPrompt(current.id);
  }

  indexLinks.forEach((link) => {
    link.addEventListener('click', () => {
      highlightPrompt(link.hash.slice(1));
    });
  });

  desktopIndex?.addEventListener('scroll', updateIndexOverflow, { passive: true });
  window.addEventListener('scroll', () => {
    if (indexUpdateScheduled) return;
    indexUpdateScheduled = true;
    requestAnimationFrame(updateCurrentPrompt);
  }, { passive: true });
  window.addEventListener('load', updateCurrentPrompt);
  window.addEventListener('resize', updateCurrentPrompt);
  updateCurrentPrompt();

  document.querySelectorAll<HTMLAnchorElement>('.prompt-index-mobile a').forEach((link) => {
    link.addEventListener('click', () => {
      link.closest('details')?.removeAttribute('open');
    });
  });

  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
  document.querySelectorAll<HTMLDetailsElement>('.prompt-details').forEach((details) => {
    let previewTimer: number | undefined;
    if (canHover.matches) {
      details.addEventListener('mouseenter', () => {
        window.clearTimeout(previewTimer);
        previewTimer = window.setTimeout(() => { details.open = true; }, 100);
      });
      details.addEventListener('mouseleave', () => {
        window.clearTimeout(previewTimer);
        if (details.dataset.pinned !== 'true') details.open = false;
      });
    }
    details.querySelector('summary')?.addEventListener('click', (event) => {
      if (canHover.matches && event instanceof MouseEvent && event.detail > 0) {
        event.preventDefault();
        window.clearTimeout(previewTimer);
        const pin = details.dataset.pinned !== 'true';
        details.dataset.pinned = String(pin);
        details.open = pin;
      } else {
        // 键盘及触屏仍由原生 details 切换，记录展开状态供桌面悬停使用。
        details.dataset.pinned = String(!details.open);
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]').forEach((button) => {
    button.addEventListener('click', async () => {
      const entry = button.closest('.prompt-entry');
      const content = entry?.querySelector('[data-prompt-content]')?.textContent;
      const label = button.querySelector('[data-copy-label]');
      const status = entry?.querySelector('[data-copy-status]');
      if (!content || !label || !status) return;
      try {
        await navigator.clipboard.writeText(content);
        label.textContent = '已复制';
        status.textContent = '完整提示词已复制到剪贴板';
        button.classList.add('copied');
      } catch {
        label.textContent = '复制失败';
        status.textContent = '无法访问剪贴板，请展开内容手动复制';
      }
      window.setTimeout(() => {
        label.textContent = '复制提示词';
        button.classList.remove('copied');
        status.textContent = '';
      }, 2200);
    });
  });
</script>

<style>
  .prompt-library { max-width: 1250px; padding-top: clamp(28px, 4vw, 48px); padding-bottom: 100px; }
  .prompt-intro { border-bottom: 1px solid var(--line); padding-bottom: clamp(24px, 3vw, 38px); }
  .prompt-eyebrow { font-size: 11px; color: var(--blue); font-weight: 650; letter-spacing: .16em; margin: 0 0 14px; }
  .prompt-intro h1 { display: flex; align-items: start; gap: 16px; font-size: clamp(42px, 5vw, 58px); font-weight: 600; line-height: 1.13; letter-spacing: -.045em; margin: 0; }
  .prompt-count { margin-top: 7px; font-size: 14px; font-family: var(--mono-font); font-weight: 400; letter-spacing: 0; color: var(--muted); }
  .prompt-intro > p:last-child { max-width: 610px; margin: 16px 0 0; font-size: 15px; line-height: 1.8; }
  .prompt-layout { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: clamp(48px, 5vw, 76px); align-items: start; }
  .prompt-index { grid-column: 1; grid-row: 1; min-width: 0; position: sticky; top: 90px; }
  .prompt-index-desktop { max-height: calc(100dvh - 110px); overflow-y: auto; padding: 24px 10px 40px 0; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--blue) 40%, transparent) transparent; }
  .prompt-index[data-has-more]::after { content: ''; position: absolute; right: 8px; bottom: 0; left: 0; height: 24px; pointer-events: none; background: linear-gradient(transparent, var(--bg)); }
  .prompt-index-desktop::-webkit-scrollbar, .prompt-index-mobile nav::-webkit-scrollbar { width: 6px; }
  .prompt-index-desktop::-webkit-scrollbar-track, .prompt-index-mobile nav::-webkit-scrollbar-track { background: transparent; }
  .prompt-index-desktop::-webkit-scrollbar-thumb, .prompt-index-mobile nav::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--blue) 38%, transparent); border-radius: 999px; }
  .prompt-index-desktop:hover::-webkit-scrollbar-thumb, .prompt-index-mobile nav:hover::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--blue) 65%, transparent); }
  .prompt-index-heading { display: flex; justify-content: space-between; margin: 0 0 16px; padding-left: 12px; color: var(--ink); font-size: 13px; font-weight: 650; }
  .prompt-index-heading span { color: var(--soft); font: 11px var(--mono-font); }
  .prompt-index-links { list-style: none; margin: 0; padding: 0; }
  .prompt-index-links a { display: flex; align-items: baseline; gap: 12px; padding: 10px 12px; border-left: 2px solid transparent; color: var(--muted); font-size: 13px; line-height: 1.55; text-decoration: none; transition: color .15s, border-color .15s, background .15s; }
  .prompt-index-links a:hover { color: var(--ink); }
  .prompt-index-links a[aria-current="location"] { border-left-color: var(--blue); color: var(--blue); background: var(--paper); font-weight: 600; }
  .prompt-index-number { flex: none; color: var(--soft); font: 11px var(--mono-font); }
  .prompt-index-links a[aria-current="location"] .prompt-index-number { color: var(--blue); }
  .prompt-index-mobile { display: none; }
  .prompt-list { min-width: 0; grid-column: 2; grid-row: 1; }
  .prompt-entry { padding: 27px 0 22px; border-bottom: 1px solid var(--line); }
  .prompt-entry-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; }
  .prompt-heading-copy { min-width: 0; }
  .prompt-entry-meta { display: flex; gap: 16px; align-items: center; margin: 0 0 14px; font-size: 11px; letter-spacing: .06em; }
  .prompt-entry-meta span:first-child { color: var(--blue); font-weight: 650; }
  .prompt-entry-meta span:last-child { color: var(--soft); font-family: var(--mono-font); }
  .prompt-entry h2 { font-size: clamp(21px, 3vw, 28px); font-weight: 600; margin: 0 0 10px; letter-spacing: -.025em; }
  .prompt-heading-copy > p:last-child { margin: 0; font-size: 14px; line-height: 1.7; }
  .prompt-copy { display: inline-flex; align-items: center; justify-content: center; gap: 9px; flex: none; min-height: 44px; padding: 0 17px; border: 1px solid var(--ink); background: var(--ink); color: var(--bg); border-radius: 4px; cursor: pointer; font-size: 13px; font-weight: 600; transition: background .18s, color .18s; }
  .prompt-copy:hover, .prompt-copy.copied { background: var(--blue); border-color: var(--blue); color: var(--bg); }
  .prompt-details { margin-top: 18px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper); overflow: hidden; }
  .prompt-details summary { display: flex; justify-content: space-between; align-items: center; gap: 14px; min-height: 48px; padding: 12px 20px; color: var(--muted); font-size: 13px; cursor: pointer; list-style: none; }
  .prompt-details summary:hover { color: var(--ink); background: var(--paper-soft); }
  .prompt-details summary::-webkit-details-marker { display: none; }
  .prompt-details summary svg { transition: transform .2s ease; }
  .prompt-details[open] summary svg { transform: rotate(180deg); }
  .prompt-details[open] summary { border-bottom: 1px solid var(--line-soft); }
  .prompt-content { display: block; margin: 0; padding: 24px; white-space: pre-wrap; overflow-wrap: anywhere; font: 14px/1.9 var(--body-font); color: var(--ink); background: transparent; tab-size: 2; }
  @media (hover: hover) and (pointer: fine) {
    .prompt-details[open]:not([data-pinned='true']) .prompt-content { max-height: min(44vh, 360px); overflow-y: auto; scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--blue) 35%, transparent) transparent; }
  }
  .prompt-copy-feedback { min-height: 20px; margin: 7px 0 0; color: var(--blue); font-size: 12px; }
  @media (max-width: 850px) {
    .prompt-layout { display: block; }
    .prompt-index { position: static; }
    .prompt-index::after { display: none; }
    .prompt-index-desktop { display: none; }
    .prompt-index-mobile { display: block; margin-top: 25px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper); }
    .prompt-index-mobile summary { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 12px 16px; cursor: pointer; list-style: none; font-size: 14px; font-weight: 600; }
    .prompt-index-mobile summary::-webkit-details-marker { display: none; }
    .prompt-index-mobile summary span { margin-left: auto; color: var(--soft); font: 11px var(--mono-font); }
    .prompt-index-mobile summary svg { transition: transform .2s; }
    .prompt-index-mobile[open] summary svg { transform: rotate(180deg); }
    .prompt-index-mobile nav { max-height: 50vh; overflow-y: auto; border-top: 1px solid var(--line-soft); padding: 8px 12px 12px; scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--blue) 40%, transparent) transparent; }
    .prompt-index-links a { min-height: 42px; align-items: center; font-size: 13px; }
  }
  @media (max-width: 650px) {
    .prompt-library { padding-top: 30px; padding-bottom: 70px; }
    .prompt-entry-heading { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
    .prompt-copy { min-height: 40px; margin-top: 0; padding: 0 13px; border-color: var(--line); background: transparent; color: var(--ink); font-size: 12px; }
    .prompt-copy:hover, .prompt-copy.copied { color: var(--bg); }
    .prompt-details { margin-top: 18px; }
    .prompt-content { padding: 18px; font-size: 14px; line-height: 1.85; }
  }
</style>

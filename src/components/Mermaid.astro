---
interface Props {
  title?: string;
  caption?: string;
  chart: string;
  wide?: boolean;
}

const { title, caption, chart, wide = false } = Astro.props;
---

<figure class:list={['mermaid-card', { 'mermaid-card--wide': wide }]}>
  {title && <figcaption class="mermaid-title">{title}</figcaption>}
  <div class="mermaid-scroll" role="group" aria-label={title || '图解'}>
    <pre class="mermaid">{chart}</pre>
  </div>
  <p class="mermaid-scroll-hint" hidden>左右滚动查看完整图解</p>
  {caption && <p class="mermaid-caption">{caption}</p>}
</figure>

<script>
  import mermaid from 'mermaid';

  mermaid.initialize({
    startOnLoad: true,
    theme: 'base',
    flowchart: { useMaxWidth: false },
    sequence: { useMaxWidth: false },
    themeVariables: {
      primaryColor: '#ffffff',
      primaryTextColor: '#111827',
      primaryBorderColor: '#cbd5e1',
      lineColor: '#64748b',
      secondaryColor: '#eef6ff',
      tertiaryColor: '#f8fafc',
    },
  });

  document.querySelectorAll<HTMLElement>('.mermaid-scroll').forEach((viewport) => {
    const diagram = viewport.querySelector('pre')!;
    const hint = viewport.nextElementSibling as HTMLElement;
    const observer = new ResizeObserver(() => {
      const overflows = viewport.scrollWidth > viewport.clientWidth + 1;
      hint.hidden = !overflows;
      if (overflows) viewport.tabIndex = 0;
      else viewport.removeAttribute('tabindex');
    });
    observer.observe(viewport);
    observer.observe(diagram);
  });
</script>

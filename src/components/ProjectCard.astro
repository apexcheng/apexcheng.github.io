---
import type { Project } from '../data/projects';
import { projectPath } from '../data/projects';
import { withBase } from '../utils/paths';

interface Props { project: Project; index: number; variant?: 'spotlight' | 'compact' }
const { project, index, variant = 'compact' } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<article class:list={['case-directory-card', `case-directory-card--${variant}`]}>
  <div class="case-directory-head">
    <span>{number} / {project.type}</span>
    <span aria-hidden="true">↗</span>
  </div>
  <h3><a href={withBase(projectPath(project))}>{project.title}</a></h3>
  <p>{project.description}</p>
  {variant === 'spotlight' && <span class="case-directory-caption">{project.category}</span>}
  <a class="case-directory-action" href={withBase(projectPath(project))} aria-label={`查看项目案例：${project.title}`}>查看案例 <span aria-hidden="true">→</span></a>
</article>

---
import type { Project } from '../data/projects';
import { projectPath } from '../data/projects';
import { withBase } from '../utils/paths';

interface Props { project: Project; index: number; variant?: 'spotlight' | 'compact' }
const { project, index, variant = 'compact' } = Astro.props;
const number = String(index + 1).padStart(2, '0');
const Heading = variant === 'spotlight' ? 'h2' : 'h3';
const titleId = `project-title-${index}`;
---

<a class:list={['case-directory-card', `case-directory-card--${variant}`]} href={withBase(projectPath(project))} aria-labelledby={titleId}>
  <div class="case-directory-head">
    <span>{number} / {project.type}</span>
    <span aria-hidden="true">↗</span>
  </div>
  <Heading class="case-directory-title" id={titleId}>{project.title}</Heading>
  <p>{project.description}</p>
  {variant === 'spotlight' && <span class="case-directory-caption">{project.category}</span>}
  <span class="case-directory-action" aria-hidden="true">查看案例 →</span>
</a>
